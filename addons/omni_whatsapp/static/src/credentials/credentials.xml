<templates xml:space="preserve">
  <t t-name="omni_whatsapp.ChannelSetup" t-inherit="omni_channel.ChannelSetup" t-inherit-mode="primary">
    <xpath expr="//t[@t-if='this.setupState.step === 1']" position="attributes">
      <attribute name="t-if">this.setupState.step === 1 &amp;&amp; !this.model.root.data.is_whatsapp</attribute>
    </xpath>
    <xpath expr="//p[@t-out='this.steps[this.setupState.step].about']" position="replace">
      <p t-if="this.model.root.data.is_whatsapp &amp;&amp; this.setupState.step === 1">Use your Meta WhatsApp credentials.</p>
      <p t-elif="this.model.root.data.is_whatsapp &amp;&amp; this.setupState.step === 2">Save the webhook, verify it in Meta, then enable receiving.</p>
      <p t-elif="this.model.root.data.is_whatsapp &amp;&amp; this.setupState.step === 4">Send the test, confirm receipt, then finish setup.</p>
      <p t-else="" t-out="this.steps[this.setupState.step].about"/>
    </xpath>
    <xpath expr="//t[@t-if='this.setupState.step === 4']" position="attributes">
      <attribute name="t-if">this.setupState.step === 4 &amp;&amp; !this.model.root.data.is_whatsapp</attribute>
    </xpath>
    <xpath expr="//button[@t-on-click='() => this.finishSetup()']" position="attributes">
      <attribute name="t-att-disabled">this.setupState.busy || (this.model.root.data.is_telegram &amp;&amp; this.model.root.data.setup_test_send_state !== 'sent') || (this.model.root.data.is_whatsapp &amp;&amp; !this.model.root.data.whatsapp_test_received)</attribute>
    </xpath>
    <xpath expr="//t[@t-if='this.setupState.step === 2']" position="attributes">
      <attribute name="t-if">this.setupState.step === 2 &amp;&amp; !this.model.root.data.is_whatsapp</attribute>
    </xpath>
    <xpath expr="//t[contains(@t-if, '!this.model.root.data.is_telegram') and contains(@t-if, 'setup_connection_ready')]" position="attributes">
      <attribute name="t-if">this.setupState.step === 2 &amp;&amp; !this.model.root.data.is_telegram &amp;&amp; !this.model.root.data.is_whatsapp &amp;&amp; !this.model.root.data.setup_connection_ready</attribute>
    </xpath>
  </t>
  <t t-name="omni_whatsapp.Credentials">
    <div class="o_omni_whatsapp_credentials w-100">
      <div class="d-flex justify-content-between align-items-center gap-3 mb-4 flex-wrap">
        <span class="badge text-bg-secondary">WhatsApp Business</span>
        <a href="https://developers.facebook.com/apps/" target="_blank" rel="noopener noreferrer">Create a Meta app ↗</a>
      </div>
      <t t-if="this.saved.phone">
        <div class="mb-4"><span class="d-block mb-2">Business account ID</span><span t-out="this.saved.account"/></div>
        <div class="mb-3"><span class="d-block mb-2">Phone number</span><span t-out="this.saved.name"/> · <span t-out="this.saved.number"/></div>
        <span class="text-success">Account verified</span>
      </t>
      <t t-else="">
        <div class="mb-4">
          <label t-att-for="this.props.id + '_token'" class="form-label d-block mb-2">Access token</label>
          <input t-att-id="this.props.id + '_token'" class="form-control" type="password" autocomplete="off" placeholder="Paste your Meta access token" t-att-value="this.state.token" t-att-disabled="this.state.busy" t-on-input="(ev) => this.change('token', ev)"/>
        </div>
        <div class="mb-4">
          <label t-att-for="this.props.id + '_account'" class="form-label d-block mb-2">Business account ID</label>
          <input t-att-id="this.props.id + '_account'" class="form-control" type="text" inputmode="numeric" placeholder="From your Meta WhatsApp setup" t-att-value="this.state.account" t-att-disabled="this.state.busy" t-on-input="(ev) => this.change('account', ev)"/>
        </div>
        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-4">
          <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="this.verify"><t t-if="this.state.busy">Verifying…</t><t t-else="">Verify account</t></button>
          <span t-if="this.state.numbers.length" class="text-success" role="status">Account verified</span>
          <span t-if="this.state.error" class="text-danger" role="alert" t-out="this.state.error"/>
        </div>
        <div t-if="this.state.numbers.length" class="mb-3">
          <label t-att-for="this.props.id + '_phone'" class="form-label d-block mb-2">Phone number</label>
          <select t-att-id="this.props.id + '_phone'" class="form-select" t-att-value="this.state.selected" t-on-change="(ev) => this.state.selected = ev.target.value">
            <option value="">Choose a number</option>
            <option t-foreach="this.state.numbers" t-as="number" t-key="number.id" t-att-value="number.id" t-att-selected="this.state.selected === number.id"><t t-out="number.name"/> · <t t-out="number.number"/></option>
          </select>
        </div>
      </t>
    </div>
  </t>
  <t t-name="omni_whatsapp.Receiving">
    <div class="w-100">
      <strong>WhatsApp Business</strong>
      <div class="mt-4 mb-4">
        <label t-att-for="this.props.id + '_url'" class="form-label d-block mb-2">Webhook URL</label>
        <input t-att-id="this.props.id + '_url'" class="form-control" type="url" t-att-value="this.state.url" t-att-disabled="this.state.busy" t-on-input="(ev) => this.state.url = ev.target.value"/>
        <small class="d-block text-muted mt-2">Use your public HTTPS address. Keep the channel path.</small>
      </div>
      <div class="mb-4">
        <label t-att-for="this.props.id + '_verify'" class="form-label d-block mb-2">Verify token</label>
        <input t-att-id="this.props.id + '_verify'" class="form-control" readonly="readonly" t-att-value="this.saved.token"/>
      </div>
      <div class="mb-4">
        <label t-att-for="this.props.id + '_secret'" class="form-label d-block mb-2">App secret</label>
        <input t-att-id="this.props.id + '_secret'" class="form-control" type="password" autocomplete="off" t-att-placeholder="this.saved.saved ? 'Saved securely' : 'From Meta app settings'" t-att-disabled="this.state.busy" t-on-input="(ev) => this.state.secret = ev.target.value" t-att-value="this.state.secret"/>
      </div>
      <p>Save, then paste the URL and verify token into Meta’s WhatsApp webhook settings. Subscribe to messages.</p>
      <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
        <button t-if="!this.saved.enabled || this.state.secret || this.state.url !== this.saved.url" type="button" class="btn btn-primary" t-att-disabled="this.state.busy" t-on-click="this.act">
          <t t-if="this.state.busy">Please wait…</t>
          <t t-elif="!this.saved.saved || this.state.secret || this.state.url !== this.saved.url">Save webhook</t>
          <t t-else="">Enable receiving</t>
        </button>
        <a href="https://developers.facebook.com/apps/" target="_blank" rel="noopener noreferrer">Open Meta settings ↗</a>
      </div>
      <p role="status" t-att-class="{'text-success': this.saved.enabled}">
        <t t-if="this.saved.enabled">Receiving enabled</t>
        <t t-elif="this.saved.verified">Callback verified</t>
        <t t-else="">Waiting for Meta verification</t>
      </p>
    </div>
  </t>
</templates>
