<odoo>
  <record id="whatsapp_setup_credentials" model="ir.ui.view">
    <field name="name">WhatsApp setup credentials</field>
    <field name="model">omni.channel</field>
    <field name="inherit_id" ref="omni_channel.channel_setup_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="attributes"><attribute name="js_class">omni_whatsapp_setup</attribute></xpath>
      <xpath expr="//sheet" position="inside"><field name="is_whatsapp" invisible="1"/></xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_1')]/field[@name='setup_connection_mode']" position="attributes">
        <attribute name="invisible">is_whatsapp</attribute>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_1')]/group" position="attributes">
        <attribute name="invisible">is_whatsapp or setup_connection_mode != 'existing'</attribute>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_1')]" position="inside">
        <field name="whatsapp_credentials_ui" widget="omni_whatsapp_credentials" nolabel="1" invisible="not is_whatsapp" groups="omni_channel.group_omni_manager"/>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_2')]/*" position="attributes">
        <attribute name="invisible">is_whatsapp</attribute>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_2')]" position="inside">
        <div invisible="not is_whatsapp">
          <field name="whatsapp_receiving_ui" widget="omni_whatsapp_receiving" nolabel="1" groups="omni_channel.group_omni_manager"/>
          <group string="Message retention">
            <field name="setup_payload_days" readonly="setup_policy_state != 'draft'"/>
            <field name="setup_message_days" readonly="setup_policy_state != 'draft'"/>
            <field name="setup_blocked_days" readonly="setup_policy_state != 'draft'"/>
          </group>
        </div>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_4')]/*" position="attributes">
        <attribute name="invisible">is_whatsapp</attribute>
      </xpath>
      <xpath expr="//div[contains(@class, 'o_omni_setup_stage_4')]" position="inside">
        <div invisible="not is_whatsapp" groups="omni_channel.group_omni_manager">
          <strong>WhatsApp Business</strong>
          <div class="mt-3 mb-4">
            <label for="whatsapp_tester_phone" class="form-label d-block mb-2"/>
            <field name="whatsapp_tester_phone" class="border rounded px-2 py-2 w-100" nolabel="1" placeholder="e.g. 60123456789" readonly="whatsapp_test_state in ('pending', 'accepted', 'unknown')"/>
          </div>
          <div class="mb-4">
            <label for="whatsapp_test_text" class="form-label d-block mb-2"/>
            <field name="whatsapp_test_text" class="border rounded px-2 py-2 w-100" nolabel="1"/>
          </div>
          <p>Tester must message your connected WhatsApp number first.</p>
          <button name="action_whatsapp_send_test" type="object" string="Send test message" class="btn-primary" invisible="whatsapp_test_state in ('pending', 'accepted', 'unknown')" confirm="Send the displayed test message to this tester? Confirm that the tester agreed to receive it."/>
          <group class="mt-3">
            <field name="whatsapp_test_state" nolabel="1" invisible="not whatsapp_test_state"/>
            <field name="whatsapp_test_received" invisible="whatsapp_test_state not in ('accepted', 'unknown')"/>
          </group>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
