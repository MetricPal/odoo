<templates xml:space="preserve">
<t t-name="workflow_center.FormButtons">
  <t t-call="web.FormView.Buttons"/>
  <ViewButton record="this.model.root" string="'Open builder'"
              className="'btn btn-primary o_workflow_open_builder'"
              clickParams="{ type: 'object', name: 'action_open_builder' }"/>
</t>
<t t-name="workflow_center.Workflows">
  <div class="d-flex flex-column h-100" t-att-class="'wf_editor_view'" t-att-id="this.inspectorId">
    <Layout display="{ controlPanel: {} }" className="'o_component_with_search_panel overflow-hidden'">
    <t t-set-slot="control-panel-buttons">
      <t t-if="this.state.workflow">
        <button class="btn btn-outline-primary wf_preview" t-on-click="() => this.testRun()">Preview / run</button>
        <button t-if="this.state.workflow.state === 'active'" class="btn btn-primary wf_pause" t-on-click="() => this.pause()">Pause</button>
        <button t-else="" class="btn btn-primary wf_activate" t-att-disabled="this.state.workflow.issues.length || !this.state.workflow.preview_current" t-on-click="() => this.activate()">Activate</button>
      </t>
    </t>
    <t t-set-slot="control-panel-additional-actions">
      <span t-if="this.state.workflow" class="ms-1 align-self-center" t-att-class="'wf_status ' + this.state.workflow.state"
            t-out="{ draft: 'Draft', active: 'Active', paused: 'Pause' }[this.state.workflow.state]"/>
    </t>
    <t t-if="this.state.page === 'builder' &amp;&amp; this.state.workflow">
      <aside t-if="this.state.workflow.can_edit" class="o_search_panel o_search_panel_wrap flex-grow-0 flex-shrink-0 pb-5 ps-3 overflow-auto position-relative wf_palette" aria-label="Add a step">
        <h3 class="mt-3">Add a step</h3>
        <p class="text-muted mb-2">Click a step to add it, or drag it onto the step it should follow. Hover for an example.</p>
        <div class="wf_insert_hint small" role="status">
          <i class="oi me-1" data-icon="subdirectory_arrow_right"/>
          <t t-if="this.state.workflow.state === 'active'">Pause the workflow to change its steps.</t>
          <t t-elif="this.insertTarget" t-out="this.insertTarget.label"/>
          <t t-else="">Select the step it should follow on the canvas first.</t>
        </div>
        <t t-foreach="this.blocks" t-as="group" t-key="group.title"><h4 class="mt-3" t-out="group.title"/>
          <button class="btn btn-light w-100 text-start mb-2 wf_palette_item" t-foreach="group.items" t-as="item" t-key="item[2]"
                  t-on-click="() => this.addFromPalette(item)" t-att-disabled="this.state.workflow.state === 'active' || this.state.busy"
                  t-att-data-tooltip="item[5]" data-tooltip-position="right"
                  t-att-draggable="this.state.workflow.state !== 'active' &amp;&amp; !this.state.busy ? 'true' : 'false'"
                  t-on-dragstart="(ev) => this.startStepDrag(ev, item)" t-on-dragend="() => { this.draggedStep = null; this.clearDropTarget(); }">
            <span class="d-flex align-items-center"><i class="oi me-2" t-att-data-icon="item[3]"/><span class="fw-semibold" t-out="item[2]"/></span>
            <span class="d-block text-muted small wf_palette_help" t-out="item[4]"/>
          </button>
        </t>
      </aside>
      <div t-if="this.state.workflow.can_edit" class="o_search_panel_resize h-100 px-2 opacity-0 opacity-100-hover" t-on-click.stop.prevent="" t-on-pointerdown.stop.prevent="this.resizeStepPanel">
        <span class="border-start border-2 border-primary h-100 d-block"/>
      </div>
      <div class="o_form_view flex-grow-1 overflow-hidden min-w-0">
      <div class="o_form_renderer d-flex d-print-block flex-nowrap h-100 wf_builder">
        <div class="o_form_sheet_bg overflow-auto o-scrollbar-thin min-w-0">
        <section class="wf_canvas" aria-label="Workflow steps" t-on-dragover="this.allowStepDrop" t-on-drop="(ev) => this.dropStep(ev)">
          <div t-if="!this.state.workflow.can_edit" class="alert alert-secondary wf_department_note" role="status">
            You can preview, activate and pause this workflow. A Settings administrator changes its steps.
          </div>
          <div t-if="this.state.workflow.ai" class="alert wf_ai_note" t-att-class="this.state.workflow.ai.done ? 'alert-info' : 'alert-secondary'" role="status">
            <t t-if="!this.state.workflow.ai.done">
              <strong>AI is drafting this workflow.</strong> It fills the name, trigger and suggested steps for you to review.
              <button type="button" class="btn btn-link p-0 ms-2 wf_ai_refresh" t-on-click="() => this.openWorkflow(this.state.workflow.id)">Check again</button>
            </t>
            <t t-else="">
              <strong>AI suggestion</strong> — review it and add the steps below. Nothing runs until you activate.
              <pre class="mb-0 mt-2 wf_ai_suggestion" t-out="this.state.workflow.ai.suggestion"/>
            </t>
          </div>
          <button t-on-dragover="this.allowStepDrop" t-on-dragenter="this.markDropTarget" t-on-drop="(ev) => this.dropStep(ev, false)" class="wf_node wf_trigger" t-att-class="{ is_selected: this.state.selected === 'trigger' }" t-on-click="() => this.configureWorkflow()"><small>WHEN</small><strong t-out="this.triggerLabel(this.state.workflow.trigger)"/><span t-out="this.state.workflow.model_id[1]"/><span>Edit trigger and record filter</span></button>
          <div class="wf_connector"/>
          <p class="wf_empty" t-if="!this.state.workflow.steps.length">Add your first action from the step menu.</p>
          <t t-call="workflow_center.Path" nodes="this.canvas.nodes"/>
          <span class="wf_end">End</span>
          <div t-if="this.canvas.unused.length" class="wf_unconnected">
            <h3>Not connected to the trigger</h3>
            <p>Connect these steps or remove them before activation.</p>
            <div t-foreach="this.canvas.unused" t-as="step" t-key="step.id" class="d-flex gap-2 m-1">
              <button class="btn btn-outline-primary" t-on-click="() => this.configureStep(step)" t-out="step.name"/>
              <button t-if="this.state.workflow.state !== 'active' &amp;&amp; this.state.workflow.can_edit" class="btn btn-link text-danger bg-transparent border-0 text-decoration-none wf_remove_step" t-att-aria-label="'Remove ' + step.name" t-on-click="() => this.removeStep(step)">×</button>
            </div>
          </div>
        </section>
        </div>
        <aside class="o-mail-ChatterContainer o-mail-Form-chatter o-aside w-print-100" aria-label="Workflow guidance">
          <div class="o-mail-Chatter w-100 h-100 flex-grow-1 d-flex flex-column bg-inherit overflow-auto o-scrollbar-thin">
          <div t-if="this.state.selected" class="o-mail-Chatter-top position-sticky top-0 bg-inherit z-1">
            <div class="o-mail-Chatter-topbar d-flex flex-wrap gap-1 px-3 wf_inspector_toolbar"/>
            <hr class="mx-3 my-3"/>
          </div>
          <div class="o-mail-Chatter-content d-flex flex-column flex-grow-1 bg-inherit">

          <section class="wf_step_inspector" t-if="this.state.selected">
            <div class="d-flex align-items-center justify-content-between px-3">
              <h3 class="mb-0" t-out="this.selectedStep ? this.selectedStep.name : 'When and which records'"/>
              <button type="button" class="btn btn-link text-muted p-1 wf_close_step" aria-label="Close step settings" title="Close and show the guide"
                      t-on-click="() => this.closeStep()"><i class="oi" data-icon="close"/></button>
            </div>
            <View t-key="this.state.selected" t-props="this.stepViewProps"/>
          </section>
            <section class="wf_builder_guide p-3" t-if="!this.state.selected"><h3>Workflow guide</h3><h4>Every workflow is When → If → Do</h4>
              <ol><li><strong>When</strong><p>A record changes, a date arrives, a schedule runs, a button is clicked or a webhook arrives.</p></li>
                <li><strong>If</strong><p>Optional conditions select the records that should run.</p></li>
                <li><strong>Do</strong><p>Update records, create tasks, send messages, wait, branch or ask for approval.</p></li>
                <li><strong>Preview, then activate</strong><p>Inspect the planned steps on a real record. Review setup, then authorize automatic execution.</p></li></ol>
            </section>
          </div>
          </div>
        </aside>
      </div>
      </div>
    </t>
    </Layout>
  </div>
</t>
<t t-name="workflow_center.InlineStepForm" t-inherit="web.FormView" t-inherit-mode="primary">
  <xpath expr="//div[@t-ref='this.rootRef']" position="attributes">
    <attribute name="class">d-flex flex-column h-auto min-w-0</attribute>
  </xpath>
  <xpath expr="//div[@class='o_form_view_container']" position="after">
    <t t-custom-portal="this.env.workflowInspectorTarget">
      <div class="wf_inspector_actions d-flex flex-wrap align-items-center gap-1">
        <t t-call="workflow_center.InspectorButtons"/>
        <t t-if="this.hasInspectorActions">
          <ViewButton record="this.model.root" string="'Configure action'" className="'btn btn-secondary'"
                      clickParams="{ type: 'object', name: 'action_configure' }"/>
        </t>
      </div>
    </t>
  </xpath>
</t>
<t t-name="workflow_center.InspectorButtons" t-inherit="web.FormView.DialogButtons" t-inherit-mode="primary">
  <xpath expr="//button[contains(@class, 'o_form_button_remove')]" position="replace">
    <button t-if="this.model.root.isInEdition and this.props.removeRecord" class="btn btn-secondary wf_remove_step" t-on-click="this.props.removeRecord">Remove step</button>
  </xpath>
</t>
<t t-name="workflow_center.Path">
  <t t-foreach="nodes" t-as="node" t-key="node.step.id">
    <div t-on-dragover="this.allowStepDrop" t-on-dragenter="this.markDropTarget" t-on-drop="(ev) => this.dropStep(ev, node.step.id)" t-att-class="'wf_node position-relative ' + (this.state.selected === node.step.id ? 'is_selected ' : '') + node.step.kind">
      <button t-if="this.state.workflow.state !== 'active' &amp;&amp; this.state.workflow.can_edit" class="btn btn-link text-danger bg-transparent border-0 text-decoration-none btn-sm position-absolute top-0 end-0 m-1 wf_remove_step" t-att-aria-label="'Remove ' + node.step.name" title="Remove step" t-on-click.stop="() => this.removeStep(node.step)">×</button>
      <button class="wf_node_select pe-4" t-on-click="() => this.configureStep(node.step)">
        <small t-out="node.step.kind === 'approval' ? 'APPROVAL · OPTIONAL' : node.step.kind.toUpperCase()"/>
        <strong t-out="node.step.name"/>
        <span t-if="node.step.kind === 'action'" t-out="node.step.action_id ? node.step.action_id[1] : 'Choose this step to configure its action'"/>
        <span t-if="node.step.kind === 'wait'"><t t-if="node.step.wait_date_id">Until <t t-out="node.step.wait_date_id[1]"/></t><t t-else=""><t t-out="node.step.wait_hours"/> hours</t></span>
      </button>
      <small t-if="node.step.end" class="wf_end">End of this path</small>
    </div>
    <div t-if="node.step.kind === 'branch'" class="wf_branch_paths">
      <section class="wf_branch_yes">
        <span class="wf_split" aria-hidden="true"/>
        <span class="wf_path_label yes">Yes</span>
        <div class="wf_connector" t-if="node.yes.length"/>
        <t t-call="workflow_center.Path" nodes="node.yes"/>
        <small t-if="!node.yes.length" class="text-muted">Continues to the next shared step</small>
        <span t-if="!this.pathEnds(node.yes)" class="wf_join" aria-hidden="true"/>
      </section>
      <section class="wf_branch_no">
        <span class="wf_split" aria-hidden="true"/>
        <span class="wf_path_label no">No</span>
        <div class="wf_connector" t-if="node.no.length"/>
        <t t-call="workflow_center.Path" nodes="node.no"/>
        <small t-if="!node.no.length" class="text-muted">Choose the No path in the branch settings</small>
        <span t-if="!this.pathEnds(node.no)" class="wf_join" aria-hidden="true"/>
      </section>
    </div>
    <div class="wf_connector" t-if="!node.step.end"/>
  </t>
</t>
<t t-name="workflow_center.TemplateButtons">
  <button type="button" class="btn btn-primary o_workflow_button_add" data-hotkey="c" t-on-click="() => this.createRecord()">New</button>
</t>
<t t-name="workflow_center.WorkflowStarter">
  <div class="o_workflow_starter" t-if="!this.props.record.resId">
        <section class="wf_describe">
          <div><h2>Describe what should happen.</h2><p>Say when it starts, which records it applies to, and what happens next.</p>
            <label for="wf_description" class="visually-hidden">Workflow description</label>
            <textarea id="wf_description" t-att-value="this.state.description" t-on-input="(ev) => this.state.description = ev.target.value" rows="3"/>
            <div class="wf_chips mt-3"><span>Try:</span>
              <button type="button" t-on-click="() => this.state.description = 'Assign new leads and book a first call.'">Assign new leads</button>
              <button type="button" t-on-click="() => this.state.description = 'Create onboarding tasks for new employees.'">Onboard employees</button>
              <button type="button" t-on-click="() => this.state.description = 'Send confirmed orders to our logistics system.'">Send orders to logistics</button>
            </div>
            <div t-if="this.state.agents.length" class="d-flex flex-wrap align-items-center gap-2 mt-3 wf_ai_draft">
              <label for="wf_agent" class="visually-hidden">Agent</label>
              <select id="wf_agent" class="form-select w-auto" t-att-value="this.state.agentId" t-on-change="(ev) => this.state.agentId = ev.target.value">
                <option t-foreach="this.state.agents" t-as="agent" t-key="agent.id" t-att-value="agent.id" t-out="agent.name"/>
              </select>
              <button type="button" class="btn btn-primary wf_draft_ai" t-att-disabled="!this.state.description.trim() || !this.state.modelId || this.state.busy" t-on-click="() => this.draftWithAi()">Draft with AI</button>
              <small class="text-muted">Uses the document chosen on the right. You review the draft before anything runs.</small>
            </div>
            <p t-elif="this.state.aiDrafting" class="mt-3 mb-0 wf_ai_no_agent">No AI agent is available to you yet. An AI manager can activate one in AI Agent; meanwhile, start blank with this description.</p>
            <p t-else="" class="mt-3 mb-0">AI drafting is not connected. Start blank to fill in the workflow settings with this description.</p>
          </div>
          <aside><h3>Or start blank</h3><label for="wf_document">Which document should this workflow watch?</label>
            <select id="wf_document" t-att-value="this.state.modelId" t-on-change="(ev) => this.state.modelId = ev.target.value"><option t-foreach="this.state.models" t-as="model" t-key="model.id" t-att-value="model.id" t-att-selected="model.id.toString() === this.state.modelId"><t t-out="model.name"/></option></select>
            <button type="button" class="btn btn-outline-primary w-100 mt-3 wf_start_blank" t-att-disabled="!this.state.modelId || this.state.busy" t-on-click="() => this.startBlank()">Start blank</button>
          </aside>
        </section>
  </div>
</t>
</templates>
