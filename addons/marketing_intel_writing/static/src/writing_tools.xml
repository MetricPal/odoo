<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="marketing_intel_writing.Sparkle">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
  </t>

  <!-- The tools of the menu (shared by the field widget and the email editor's toolbar) -->
  <t t-name="marketing_intel_writing.ToolItems">
    <t t-foreach="tools" t-as="tool" t-key="tool">
      <t t-if="tool === 'tone'">
        <Dropdown>
          <button type="button" class="dropdown-item">Tone</button>
          <t t-set-slot="content">
            <DropdownItem t-foreach="tones" t-as="tone" t-key="tone[0]" class="'o_mi_writing_tone'" onSelected="() =&gt; onPick('tone', tone[0])"><t t-out="tone[1]"/></DropdownItem>
          </t>
        </Dropdown>
      </t>
      <t t-elif="tool === 'translate'">
        <Dropdown>
          <button type="button" class="dropdown-item">Translate</button>
          <t t-set-slot="content">
            <DropdownItem t-foreach="languages" t-as="lang" t-key="lang[0]" class="'o_mi_writing_lang'" onSelected="() =&gt; onPick('translate', lang[0])"><t t-out="lang[1]"/></DropdownItem>
            <div class="px-3 py-1 small text-muted">The company's active languages</div>
          </t>
        </Dropdown>
      </t>
      <t t-elif="tool === 'custom'">
        <div class="dropdown-divider"/>
        <DropdownItem class="'o_mi_writing_custom'" onSelected="() =&gt; onCustom()">Ask something else&#8230;</DropdownItem>
      </t>
      <DropdownItem t-else="" class="'o_mi_writing_tool'" attrs="{'data-tool': tool}" onSelected="() =&gt; onPick(tool, false)"><t t-out="label(tool)"/></DropdownItem>
    </t>
  </t>

  <t t-name="marketing_intel_writing.WritingTools">
    <div class="o_mi_writing" t-ref="this.rootRef">
      <div class="o_mi_writing_overlay" t-att-style="'height: ' + this.state.boxHeight + 'px'">
        <div t-if="this.tools.available" class="o_mi_writing_corner">
          <Dropdown>
            <button type="button" t-attf-class="btn btn-sm o_mi_writing_button o_mi_writing_icon {{ this.state.suggestion or this.state.customOpen ? 'active' : '' }}"
                    aria-label="Writing tools" title="Writing tools">
              <t t-call="marketing_intel_writing.Sparkle"/>
            </button>
            <t t-set-slot="content">
              <t t-call="marketing_intel_writing.ToolItems" tools="this.tools.tools" tones="this.tones" languages="this.tools.languages"
                 onPick="(tool, option) =&gt; this.ask(tool, option)" onCustom="() =&gt; this.openCustom()" label="(tool) =&gt; this.label(tool)"/>
            </t>
          </Dropdown>
        </div>
        <t t-set="boxCount" t-value="this.boxCount"/>
        <span t-if="boxCount" t-attf-class="o_mi_writing_box_count {{ boxCount.level === 'over' ? 'text-danger' : (boxCount.level === 'long' ? 'text-warning' : 'text-muted') }}"
              t-att-title="boxCount.title" t-out="boxCount.label"/>
      </div>

      <section t-if="this.state.customOpen" class="o_mi_writing_card d-flex flex-column gap-2" aria-label="Ask something else">
        <label class="fw-semibold" t-att-for="'mi_writing_custom_' + this.props.field">What should the assistant do with the text?</label>
        <div class="d-flex gap-2">
          <input t-att-id="'mi_writing_custom_' + this.props.field" class="form-control o_mi_writing_custom_input" maxlength="500"
                 placeholder="e.g. Mention that the shop is open on Sunday" t-att-value="this.state.customText" t-on-input="(ev) =&gt; { this.state.customText = ev.target.value; }"
                 t-on-keydown="(ev) =&gt; this.onCustomKeydown(ev)"/>
          <button type="button" class="btn btn-primary" t-on-click="() =&gt; this.askCustom()">Ask</button>
          <button type="button" class="btn btn-secondary" t-on-click="() =&gt; this.discard()">Discard</button>
        </div>
      </section>

      <section t-if="this.state.suggestion" t-att-aria-label="this.state.suggestion.tool === 'subjects' ? 'Subject lines' : 'Suggestion'" class="o_mi_writing_card d-flex flex-column gap-2" aria-live="polite">
        <t t-set="s" t-value="this.state.suggestion"/>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <strong class="o_mi_writing_title" t-out="this.label(s.tool, s.option)"/>
          <span class="badge o_mi_writing_ai">AI</span>
          <span class="text-muted small" t-out="this.tools.agent"/>
          <t t-if="s.state === 'ready' and s.tool !== 'subjects'">
            <t t-set="count" t-value="this.countFor(s.text)"/>
            <span t-attf-class="ms-auto small o_mi_writing_count {{ count.over ? 'text-danger' : 'text-muted' }}" t-out="count.label"/>
          </t>
        </div>

        <div t-if="s.state === 'waiting'" class="d-flex align-items-center gap-2 text-muted">
          <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"/>
          <span>Writing&#8230;</span>
          <button type="button" class="btn btn-link btn-sm p-0" t-on-click="() =&gt; this.discard()">Stop</button>
        </div>

        <t t-elif="s.state === 'failed'">
          <div class="alert alert-warning mb-0 py-2" role="alert" t-out="s.error"/>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.tryAgain()">Try again</button>
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.discard()">Discard</button>
          </div>
        </t>

        <t t-elif="s.tool === 'subjects'">
          <div t-foreach="s.lines" t-as="line" t-key="line_index" class="d-flex flex-wrap align-items-center gap-2 py-1 o_mi_writing_line">
            <span class="flex-grow-1" t-out="line"/>
            <span class="text-muted small"><t t-out="this.chars(line)"/> characters</span>
            <button type="button" class="btn btn-primary btn-sm" t-on-click="() =&gt; this.use(line)">Use</button>
            <button t-if="this.tools.ab_test" type="button" class="btn btn-secondary btn-sm" t-att-disabled="this.state.abBusy" t-on-click="() =&gt; this.abTest(line)">A/B test it</button>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.tryAgain()">More</button>
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.discard()">Discard</button>
            <span t-if="this.tools.ab_test" class="ms-auto text-muted small">A/B test it: Odoo's own A/B test, a copy of this mailing with that subject</span>
          </div>
        </t>

        <t t-else="">
          <p class="mb-0 o_mi_writing_text" t-out="s.text"/>
          <div t-if="s.warning" class="alert alert-warning mb-0 py-1 small" role="status" t-out="s.warning"/>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" t-on-click="() =&gt; this.use(s.text)">Use</button>
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.tryAgain()">Try again</button>
            <button type="button" class="btn btn-secondary btn-sm" t-on-click="() =&gt; this.discard()">Discard</button>
            <span class="ms-auto text-muted small">Your text stays until you click Use</span>
          </div>
        </t>
      </section>
    </div>
  </t>

</templates>
