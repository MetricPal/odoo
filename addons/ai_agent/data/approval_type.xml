<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Agent proposals (ADR 0012, phase 4): approved like any approval type; Approvals managers set who approves.
       By default the manager of the person who asked approves. Once approved, the proposal is applied at once. -->
  <record id="approval_type_agent_proposal" model="approval.center.policy">
    <field name="name">AI agent proposal</field>
    <field name="description">A note, to-do or field change an AI agent prepared. Nothing changes until it is approved.</field>
    <field name="sequence">90</field>
    <field name="model_id" ref="ai_agent.model_ai_agent_proposal"/>
    <field name="action_name">action_apply</field>
    <field name="manager_approval">1</field>
    <field name="approval_minimum">1</field>
  </record>
</odoo>
