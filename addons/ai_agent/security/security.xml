<odoo>
  <record id="privilege_ai_agent" model="res.groups.privilege"><field name="name">AI Agent</field><field name="category_id" ref="base.module_category_productivity"/></record>
  <record id="group_user" model="res.groups"><field name="name">User</field><field name="privilege_id" ref="privilege_ai_agent"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_manager" model="res.groups"><field name="name">Manager</field><field name="privilege_id" ref="privilege_ai_agent"/><field name="implied_ids" eval="[(4, ref('group_user'))]"/></record>
  <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('ai_agent.group_manager'))]"/></record>
</odoo>
