<odoo>
  <record id="agent_search" model="ir.ui.view">
    <field name="name">ai.agent.search</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="description" />
        <filter name="active_agents" string="Active" domain="[('state', '=', 'active')]" />
        <filter name="draft_agents" string="Draft" domain="[('state', '=', 'draft')]" />
        <filter name="paused_agents" string="Paused" domain="[('state', '=', 'paused')]" />
        <group>
          <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company" />
        </group>
      </search>
    </field>
  </record>
  <record id="agent_kanban" model="ir.ui.view">
    <field name="name">ai.agent.kanban</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="state" />
        <templates>
          <t t-name="card">
            <div class="d-flex justify-content-between">
              <field name="name" class="fw-bold fs-5" />
              <field name="state" widget="label_selection" />
            </div>
            <field name="description" class="text-muted mt-2" />
            <div class="mt-3">
              <button name="action_chat" type="object" string="Chat" class="btn btn-primary" invisible="state != 'active'" />
              <button name="action_configure" type="object" string="Configure" class="btn btn-link" groups="ai_agent.group_manager" />
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="agent_list" model="ir.ui.view">
    <field name="name">ai.agent.list</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="description" />
        <field name="state" />
        <field name="company_id" groups="base.group_multi_company" optional="hide" />
        <field name="engine_id" optional="hide" />
        <field name="response_style" optional="hide" />
        <field name="max_requests_per_day" optional="hide" />
        <field name="revision" optional="hide" />
        <button name="action_chat" type="object" string="Chat" invisible="state != 'active'" />
      </list>
    </field>
  </record>
  <record id="agent_form" model="ir.ui.view">
    <field name="name">ai.agent.form</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <form string="AI Agent">
        <header>
          <field name="can_configure" invisible="1"/><field name="edit_live" invisible="1"/>
          <button name="action_pause" string="Pause / Edit" type="object" invisible="state != 'active' or not can_configure" confirm="New requests are blocked and active ones are canceled, but you may still be billed for work already started." />
          <button name="action_chat" string="Chat" type="object" class="btn-primary" invisible="state != 'active'" />
          <button name="action_activate" string="Activate" type="object" invisible="state == 'active' or not can_configure" confirm="Selected users will be able to chat using your configured data settings and limits." />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name" string="Agent name" />
            <h1>
              <field name="name" placeholder="e.g. Sales Assistant" readonly="state == 'active' and not edit_live" />
            </h1>
          </div>
          <group>
            <group string="Purpose">
              <field name="description" string="What it helps with" placeholder="e.g. Review opportunities and prepare follow-ups" readonly="state == 'active' and not edit_live" />
              <field name="department_id" options="{'no_create': True}" readonly="state == 'active' and not edit_live" />
              <field name="profile_mode" widget="radio" groups="ai_agent.group_manager" readonly="state == 'active'"/>
              <field name="profile_id" groups="ai_agent.group_manager" placeholder="Connection default"/>
              <button name="action_own_profile" type="object" string="Give it its own profile" class="btn-link p-0"
                      colspan="2" groups="ai_agent.group_manager"
                      invisible="state == 'active' or profile_mode == 'own'"/>
              <field name="response_style" widget="radio" readonly="state == 'active' and not edit_live" />
            </group>
            <group string="People &amp; company">
              <field name="company_id" groups="base.group_multi_company" readonly="id" />
              <field name="access_scope" string="Who can chat" widget="radio" options="{'horizontal': true}" readonly="state == 'active' and not edit_live"/>
              <field name="department_ids" widget="many2many_tags" placeholder="Select departments…" domain="[('company_id', '=', company_id), ('active', '=', True)]" options="{'no_create': True}" invisible="access_scope == 'company'" readonly="state == 'active' and not edit_live"/>
              <field name="user_ids" widget="many2many_tags" placeholder="Select users…" domain="[('share', '=', False), ('active', '=', True), ('company_ids', 'in', [company_id])]" invisible="access_scope == 'company'" readonly="state == 'active' and not edit_live"/>
            </group>
          </group>
          <notebook invisible="not can_configure">
            <page string="Instructions">
              <p class="text-muted">Define the role, goals and expected answers. Instructions never override permissions.</p>
              <field name="system_prompt" nolabel="1" readonly="state == 'active' and not edit_live" placeholder="Describe what the agent should help with, how it should answer, and when it should ask for clarification." />
              <p class="text-muted" invisible="not edit_live">Your changes apply at once and are recorded in the history below.</p>
            </page>
            <page string="Skills &amp; sources">
              <group>
                <group string="Skills">
                  <field name="skill_ids" string="Approved skills" placeholder="Select approved skills…" widget="many2many_tags" domain="[('company_id', '=', company_id), ('state', '=', 'approved')]" readonly="state == 'active' and not edit_live" />
                  <div class="text-muted" colspan="2">Skills define how the agent reasons and prepares work.</div>
                </group>
                <group string="Knowledge" groups="ai_agent.group_manager">
                  <field name="source_ids" string="Knowledge sources" widget="many2many_tags" domain="[('company_id', '=', company_id), ('state', '=', 'ready')]" readonly="state == 'active'" />
                  <field name="restrict_sources" string="Ground answers in sources" readonly="state == 'active'" />
                  <div class="text-muted" colspan="2">Each source is checked against the requesting person's access rights.</div>
                </group>
              </group>
            </page>
            <page string="Data access" groups="ai_agent.group_manager">
              <p class="text-muted">Choose the business data this agent may use. On a synced Hermes profile the agent looks it up with Odoo's tools, as the department's AI assistant and, in a chat, only what the person asking may see too. Without a profile the data is sent with the question, read as the person asking. These scopes narrow access; they never grant extra permissions. Business changes and external actions are disabled.</p>
              <field name="access_ids" readonly="state == 'active'">
                <list editable="bottom">
                  <field name="model_name" string="Business document" />
                  <field name="field_names" string="Fields to share" placeholder="name, email" />
                  <field name="domain_json" string="Record filter" optional="hide" />
                  <field name="limit" string="Maximum records" />
                  <field name="record_order" optional="show" />
                </list>
                <form string="Permitted business data">
                  <sheet>
                    <group>
                      <field name="model_name" string="Business document" />
                      <field name="field_names" string="Fields to share" placeholder="name, email" />
                      <field name="limit" string="Maximum records" />
                      <field name="record_order" widget="radio" />
                    </group>
                    <group string="Advanced record filter">
                      <field name="domain_json" placeholder="[]" />
                      <p class="text-muted">JSON record filter. Leave [] to use the requester's existing record permissions without an additional filter.</p>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Engine &amp; limits" groups="ai_agent.group_manager">
              <group>
                <group string="Connection">
                  <field name="engine_id" string="Hermes connection" placeholder="Select a Hermes connection…" domain="[('company_id', '=', company_id)]" readonly="state == 'active'" />
                  <field name="engine_model_id" domain="[('engine_id', '=', engine_id), ('enabled', '=', True)]" options="{'no_create': True, 'no_open': True}" placeholder="Use engine default" readonly="state == 'active'"/>
                  <div class="text-muted" colspan="2">Choose a model enabled on this connection, or leave blank to use Hermes's default.</div>
                  <field name="provider" invisible="1"/><field name="model" invisible="1"/>
                </group>
                <group string="Request limits">
                  <field name="max_concurrent" string="Requests at the same time" readonly="state == 'active'" />
                  <field name="max_requests_per_day" string="Requests per day" readonly="state == 'active'" />
                  <field name="max_requests_per_user_day" string="Requests per person per day" readonly="state == 'active'" />
                  <field name="revision" string="Configuration revision" />
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <record id="action_agents" model="ir.actions.act_window">
    <field name="name">Agents</field>
    <field name="res_model">ai.agent</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first supervised assistant</p>
      <p>Connect Hermes, choose who may use it, and select its skills and permitted knowledge.</p>
    </field>
  </record>
</odoo>
