<odoo>
  <record id="agent_search" model="ir.ui.view">
    <field name="name">ai.agent.search</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="description" />
        <filter name="active_agents" string="Active" domain="[('state', '=', 'active')]" />
        <filter name="draft_agents" string="Draft" domain="[('state', '=', 'draft')]" />
        <filter name="paused_agents" string="Paused" domain="[('state', '=', 'paused')]" />
        <group>
          <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company" />
        </group>
      </search>
    </field>
  </record>
  <record id="agent_kanban" model="ir.ui.view">
    <field name="name">ai.agent.kanban</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="state" />
        <templates>
          <t t-name="card">
            <div class="d-flex justify-content-between">
              <field name="name" class="fw-bold fs-5" />
              <field name="state" widget="label_selection" />
            </div>
            <field name="description" class="text-muted mt-2" />
            <div class="mt-3">
              <button name="action_chat" type="object" string="Chat" class="btn btn-primary" invisible="state != 'active'" />
              <button name="action_configure" type="object" string="Configure" class="btn btn-link" groups="ai_agent.group_manager" />
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="agent_list" model="ir.ui.view">
    <field name="name">ai.agent.list</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="description" />
        <field name="state" />
        <field name="company_id" groups="base.group_multi_company" optional="hide" />
        <field name="engine_id" optional="hide" />
        <field name="response_style" optional="hide" />
        <field name="max_requests_per_day" optional="hide" />
        <field name="revision" optional="hide" />
        <button name="action_chat" type="object" string="Chat" invisible="state != 'active'" />
      </list>
    </field>
  </record>
  <record id="agent_form" model="ir.ui.view">
    <field name="name">ai.agent.form</field>
    <field name="model">ai.agent</field>
    <field name="arch" type="xml">
      <form string="AI Agent">
        <header>
          <button name="action_chat" string="Chat" type="object" class="btn-primary" invisible="state != 'active'" />
          <button name="action_activate" string="Activate" type="object" groups="ai_agent.group_manager" invisible="state == 'active'" confirm="Activate for these users, data scopes and limits? Requests share permitted context with the configured model provider. Business actions remain disabled." />
          <button name="action_pause" string="Pause" type="object" groups="ai_agent.group_manager" invisible="state != 'active'" confirm="Block new requests and request cancellation of active runs? Accepted inference may still incur cost." />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name" string="Agent name" />
            <h1>
              <field name="name" placeholder="e.g. Sales Assistant" readonly="state == 'active'" />
            </h1>
          </div>
          <group>
            <group string="Purpose">
              <field name="description" string="What it helps with" placeholder="e.g. Review opportunities and prepare follow-ups" readonly="state == 'active'" />
              <field name="response_style" readonly="state == 'active'" />
            </group>
            <group string="People &amp; company">
              <field name="company_id" groups="base.group_multi_company" readonly="id" />
              <field name="user_ids" string="Who can chat" widget="many2many_tags" domain="[('share', '=', False)]" readonly="state == 'active'" />
            </group>
          </group>
          <div class="text-muted mb-3" invisible="state != 'active'" groups="ai_agent.group_manager">Pause this agent before editing its configuration. Changes require another activation review.</div>
          <notebook groups="ai_agent.group_manager">
            <page string="Instructions">
              <p class="text-muted">Define the role, goals and expected answers. Instructions never override Odoo permissions.</p>
              <field name="system_prompt" nolabel="1" readonly="state == 'active'" placeholder="Describe what the agent should help with, how it should answer, and when it should ask for clarification." />
            </page>
            <page string="Skills &amp; sources">
              <group>
                <group string="Skills">
                  <field name="skill_ids" string="Approved skills" widget="many2many_tags" domain="[('company_id', '=', company_id), ('state', '=', 'approved')]" readonly="state == 'active'" />
                  <div class="text-muted" colspan="2">Skills define how the agent reasons and prepares work.</div>
                </group>
                <group string="Knowledge">
                  <field name="source_ids" string="Knowledge sources" widget="many2many_tags" domain="[('company_id', '=', company_id), ('state', '=', 'ready')]" readonly="state == 'active'" />
                  <field name="restrict_sources" string="Ground answers in sources" readonly="state == 'active'" />
                  <div class="text-muted" colspan="2">Each source is checked against the requesting person's Odoo access rights.</div>
                </group>
              </group>
            </page>
            <page string="Data access">
              <p class="text-muted">Reads use the requesting person's Odoo permissions. Business changes and external actions are disabled in this release.</p>
              <p class="text-muted">Choose which business data may be supplied as context. These scopes narrow access; they never grant extra Odoo permissions.</p>
              <field name="access_ids" readonly="state == 'active'">
                <list editable="bottom">
                  <field name="model_name" string="Business document" />
                  <field name="field_names" string="Fields to share" placeholder="name, email" />
                  <field name="domain_json" string="Record filter" optional="hide" />
                  <field name="limit" string="Maximum records" />
                </list>
                <form string="Permitted business data">
                  <sheet>
                    <group>
                      <field name="model_name" string="Business document" />
                      <field name="field_names" string="Fields to share" placeholder="name, email" />
                      <field name="limit" string="Maximum records" />
                    </group>
                    <group string="Advanced record filter">
                      <field name="domain_json" placeholder="[]" />
                      <p class="text-muted">JSON Odoo domain. Leave [] to use the requester's existing record permissions without an additional filter.</p>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
            <page string="Engine &amp; limits">
              <group>
                <group string="Connection">
                  <field name="engine_id" string="Hermes connection" domain="[('company_id', '=', company_id)]" readonly="state == 'active'" />
                  <field name="engine_model_id" domain="[('engine_id', '=', engine_id), ('enabled', '=', True)]" options="{'no_create': True, 'no_open': True}" placeholder="Use engine default" readonly="state == 'active'"/>
                  <div class="text-muted" colspan="2">Choose a model enabled on this connection, or leave blank to use Hermes's default.</div>
                  <field name="provider" invisible="1"/><field name="model" invisible="1"/>
                </group>
                <group string="Request limits">
                  <field name="max_concurrent" string="Requests at the same time" readonly="state == 'active'" />
                  <field name="max_requests_per_day" string="Requests per day" readonly="state == 'active'" />
                  <field name="revision" string="Configuration revision" />
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <record id="action_agents" model="ir.actions.act_window">
    <field name="name">Agents</field>
    <field name="res_model">ai.agent</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first supervised assistant</p>
      <p>Connect Hermes, choose who may use it, and select its skills and permitted knowledge.</p>
    </field>
  </record>
</odoo>
