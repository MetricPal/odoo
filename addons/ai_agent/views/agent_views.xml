<odoo>
  <record id="agent_search" model="ir.ui.view"><field name="name">ai.agent.search</field><field name="model">ai.agent</field><field name="arch" type="xml"><search><field name="name"/><field name="description"/><filter name="active_agents" string="Active" domain="[('state', '=', 'active')]"/><filter name="draft_agents" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="paused_agents" string="Paused" domain="[('state', '=', 'paused')]"/><group><filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
  <record id="agent_kanban" model="ir.ui.view"><field name="name">ai.agent.kanban</field><field name="model">ai.agent</field><field name="arch" type="xml"><kanban><field name="state"/><templates><t t-name="card"><div class="d-flex justify-content-between"><field name="name" class="fw-bold fs-5"/><field name="state" widget="label_selection"/></div><field name="description" class="text-muted mt-2"/><div class="mt-3"><button name="action_chat" type="object" string="Chat" class="btn btn-primary" invisible="state != 'active'"/><button name="action_configure" type="object" string="Configure" class="btn btn-link" groups="ai_agent.group_manager"/></div></t></templates></kanban></field></record>
  <record id="agent_list" model="ir.ui.view"><field name="name">ai.agent.list</field><field name="model">ai.agent</field><field name="arch" type="xml"><list><field name="name"/><field name="description"/><field name="state"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="engine_id" optional="hide"/><field name="response_style" optional="hide"/><field name="max_requests_per_day" optional="hide"/><field name="revision" optional="hide"/><button name="action_chat" type="object" string="Chat" invisible="state != 'active'"/></list></field></record>
  <record id="agent_form" model="ir.ui.view"><field name="name">ai.agent.form</field><field name="model">ai.agent</field><field name="arch" type="xml"><form><header><button name="action_chat" string="Chat" type="object" class="btn-primary" invisible="state != 'active'"/><button name="action_activate" string="Activate" type="object" groups="ai_agent.group_manager" invisible="state == 'active'" confirm="Activate this assistant for the selected users, data scopes and request limits? Requests send their permitted context to the configured model provider. Business actions remain disabled."/><button name="action_pause" string="Pause" type="object" groups="ai_agent.group_manager" invisible="state != 'active'" confirm="Block new requests and request cancellation of active runs? Already accepted inference may still incur cost."/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="state == 'active'"/></h1><field name="description" placeholder="What does this assistant help with?" readonly="state == 'active'"/></div><group><field name="company_id" groups="base.group_multi_company" readonly="id"/><field name="user_ids" widget="many2many_tags" domain="[('share', '=', False)]" readonly="state == 'active'"/><field name="response_style" readonly="state == 'active'"/></group><notebook groups="ai_agent.group_manager"><page string="Instructions"><field name="system_prompt" readonly="state == 'active'" placeholder="Describe the role, objectives and how to handle uncertainty."/></page><page string="Skills &amp; sources"><group><field name="skill_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" readonly="state == 'active'"/><field name="source_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" readonly="state == 'active'"/><field name="restrict_sources" readonly="state == 'active'"/></group></page><page string="Data access"><p class="text-muted">Reads use the requesting person's Odoo permissions. Business changes and external actions are disabled in this release.</p><field name="access_ids" readonly="state == 'active'"><list editable="bottom"><field name="model_name"/><field name="field_names"/><field name="domain_json"/><field name="limit"/></list></field></page><page string="Engine &amp; limits"><group><field name="engine_id" domain="[('company_id', '=', company_id)]" readonly="state == 'active'"/><field name="provider" readonly="state == 'active'"/><field name="model" readonly="state == 'active'"/><field name="max_concurrent" readonly="state == 'active'"/><field name="max_requests_per_day" readonly="state == 'active'"/><field name="revision"/></group></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_agents" model="ir.actions.act_window"><field name="name">Agents</field><field name="res_model">ai.agent</field><field name="view_mode">kanban,list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first supervised assistant</p><p>Connect Hermes, choose who may use it, and select its skills and permitted knowledge.</p></field></record>
</odoo>
