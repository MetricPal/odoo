<odoo>
  <record id="model_picker_form" model="ir.ui.view">
    <field name="name">ai.agent.model.picker.form</field><field name="model">ai.agent.model.picker</field>
    <field name="arch" type="xml">
      <form string="Providers and models">
        <group><field name="engine_id" string="Hermes connection" readonly="1"/></group><field name="agent_id" invisible="1"/>
        <field name="provider" invisible="1"/><field name="model" invisible="1"/>
        <field name="use_default" invisible="not agent_id"/>
        <div class="w-100"><field name="catalog" widget="ai_agent_model_picker" nolabel="1"/></div>
        <field name="model_settings_url" invisible="1"/>
        <p class="text-muted">Keys are checked by Hermes and saved only in Hermes. Sign-in and cloud providers are set up in Hermes. A provider that is ready does not guarantee access to every model.</p>
        <footer>
          <button name="action_apply" string="Use selected model" type="object" class="btn-primary" invisible="not agent_id"/>


          <button string="Close" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
