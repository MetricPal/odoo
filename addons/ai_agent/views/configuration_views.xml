<odoo>
  <record id="engine_list" model="ir.ui.view"><field name="name">ai.agent.engine.list</field><field name="model">ai.agent.engine</field><field name="arch" type="xml"><list><field name="name"/><field name="state"/><field name="checked_at"/><field name="url" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/><field name="status_message" optional="hide"/></list></field></record>
  <record id="engine_form" model="ir.ui.view"><field name="name">ai.agent.engine.form</field><field name="model">ai.agent.engine</field><field name="arch" type="xml"><form><header><button name="action_check" string="Check connection" type="object" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><field name="company_id" groups="base.group_multi_company"/><field name="url" placeholder="https://hermes.example.com"/><field name="secret_reference" placeholder="AI_AGENT_SECRET_SALES"/><field name="management_url"/><field name="management_secret_reference"/><field name="status_message"/><field name="checked_at"/></group><p class="text-muted">Use a dedicated profile with tools and shared memory disabled. Credentials are provisioned securely by the deployment administrator.</p><notebook><page string="Models"><field name="models_catalog"/></page><page string="Tools"><field name="toolsets"/></page><page string="Capabilities"><field name="capabilities"/></page></notebook></sheet></form></field></record>
  <record id="action_engines" model="ir.actions.act_window"><field name="name">Hermes engines</field><field name="res_model">ai.agent.engine</field><field name="view_mode">list,form</field></record>
  <record id="skill_list" model="ir.ui.view"><field name="name">ai.agent.skill.list</field><field name="model">ai.agent.skill</field><field name="arch" type="xml"><list><field name="name"/><field name="description"/><field name="state"/><field name="revision" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/></list></field></record>
  <record id="skill_form" model="ir.ui.view"><field name="name">ai.agent.skill.form</field><field name="model">ai.agent.skill</field><field name="arch" type="xml"><form><header><button name="action_approve" string="Approve skill" type="object" class="btn-primary" invisible="state == 'approved'" confirm="Approve these instructions for use by assigned agents? Changing them requires another review."/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><field name="description"/><field name="company_id" groups="base.group_multi_company"/><field name="revision"/></group><field name="instructions" placeholder="Purpose, steps, expected output and when to ask for clarification."/><p class="text-muted">Skills guide reasoning and drafting. They do not authorize business changes.</p></sheet><chatter/></form></field></record>
  <record id="action_skills" model="ir.actions.act_window"><field name="name">Skills</field><field name="res_model">ai.agent.skill</field><field name="view_mode">list,form</field></record>
  <record id="source_list" model="ir.ui.view"><field name="name">ai.agent.source.list</field><field name="model">ai.agent.source</field><field name="arch" type="xml"><list><field name="name"/><field name="kind"/><field name="state"/><field name="active"/><field name="revision" optional="hide"/><field name="filename" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/></list></field></record>
  <record id="source_form" model="ir.ui.view"><field name="name">ai.agent.source.form</field><field name="model">ai.agent.source</field><field name="arch" type="xml"><form><header><button name="action_prepare" string="Prepare source" type="object" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><field name="company_id" groups="base.group_multi_company"/><field name="kind"/><field name="active"/><field name="user_ids" widget="many2many_tags" domain="[('share', '=', False)]"/><field name="revision"/><field name="status_message"/><field name="filename" invisible="1"/><field name="file" filename="filename" invisible="kind != 'file'"/></group><field name="text" invisible="kind != 'text'" placeholder="Paste reference knowledge here."/><notebook><page string="Prepared text"><field name="extracted_text"/></page></notebook></sheet></form></field></record>
  <record id="action_sources" model="ir.actions.act_window"><field name="name">Sources</field><field name="res_model">ai.agent.source</field><field name="view_mode">list,form</field></record>
</odoo>
