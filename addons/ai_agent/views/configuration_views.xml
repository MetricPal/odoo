<odoo>
  <record id="engine_list" model="ir.ui.view">
    <field name="name">ai.agent.engine.list</field><field name="model">ai.agent.engine</field>
    <field name="arch" type="xml"><list><field name="name" string="Connection"/><field name="state"/><field name="checked_at"/><field name="connection_mode" optional="hide"/><field name="url" widget="url" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/><field name="status_message" optional="hide"/></list></field>
  </record>
  <record id="engine_form" model="ir.ui.view">
    <field name="name">ai.agent.engine.form</field><field name="model">ai.agent.engine</field>
    <field name="arch" type="xml">
      <form string="Hermes connection">
        <header><button name="action_check" string="Connect" type="object" class="btn-primary" invisible="state == 'ready'"/><button name="action_check" string="Check connection" type="object" invisible="state != 'ready'"/><field name="state" widget="ai_agent_connection_status" class="ms-auto me-2"/><field name="state" widget="statusbar"/></header>
        <sheet>
          <div class="oe_title"><label for="name" string="Connection name"/><h1><field name="name" placeholder="e.g. Local Hermes"/></h1></div>
          <group><field name="company_id" groups="base.group_multi_company" readonly="id"/><field name="connection_mode" string="Connection" widget="radio" options="{'horizontal': true}"/></group>
          <group string="Local connection" invisible="connection_mode != 'local'">
            <div class="text-muted" colspan="2">Local addresses and credentials are configured automatically.</div>
          </group>
          <group>
          <group string="Remote connection" invisible="connection_mode != 'remote'">
            <field name="url" widget="url" placeholder="https://hermes.example.com"/>
            <field name="api_key_saved" invisible="1"/>
            <field name="api_key" password="True" placeholder="Enter API key, or leave blank to keep the saved key" autocomplete="new-password"/>
            <div class="text-muted" invisible="not api_key_saved" colspan="2">API key saved securely. Leave blank to keep it.</div>
          </group>
              <group string="Management connection">
                <field name="management_same_connection" invisible="connection_mode != 'remote'"/>
                <field name="management_url" widget="url" placeholder="https://management.example.com" invisible="management_same_connection" readonly="connection_mode == 'local'"/>
                <field name="management_api_key" password="True" placeholder="Enter a separate management API key if required" invisible="connection_mode == 'local' or management_same_connection" autocomplete="new-password"/>
                <field name="management_key_saved" invisible="1"/>
                <div class="text-muted" invisible="not management_key_saved or connection_mode == 'local' or management_same_connection" colspan="2">Management API key saved securely. Leave blank to keep it.</div>
                <field name="url" string="Agent API URL" widget="url" readonly="1" invisible="connection_mode != 'local'"/>
              </group>

          </group>
          <p class="text-muted">The Agent API runs requests. The Management API checks this profile's configuration. Hermes tools and shared memory must be disabled for this release.</p>
          <div class="alert alert-warning" role="alert" invisible="state != 'blocked'"><field name="status_message" nolabel="1"/></div>
          <group invisible="not checked_at"><field name="checked_at" string="Last checked"/></group>
          <notebook>
            <page string="Providers &amp; models">
              <div class="d-flex align-items-center gap-3 mb-3">
                <button name="action_models" string="Add model" type="object" class="btn-primary" invisible="not id"/>
              </div>
              <div class="d-flex flex-wrap align-items-baseline gap-1 mb-3">
                <span>You may configure the models in</span>
                <field name="model_settings_url" widget="url" text="Model Settings" readonly="1" nolabel="1" class="w-auto"/>
                <span>; changes apply to new sessions.</span>
              </div>
              <p class="text-muted">Add models for your agents. Hermes's default model stays unchanged.</p>
              <separator string="Enabled models"/>
              <field name="enabled_model_ids" nolabel="1" readonly="1">
                <list create="0" delete="0"><field name="provider"/><field name="model"/><field name="create_uid" string="Enabled by" optional="hide"/><field name="write_date" string="Last changed" optional="hide"/><button name="action_disable" string="Remove" type="object" confirm="Disable this model for agents on this connection? Agents using it will be blocked until another model is selected."/></list>
              </field>
            </page>
            <page string="Diagnostics" groups="base.group_system">
              <p class="text-muted">Read-only data reported by Hermes. Viewing it does not change engine settings.</p>
              <group><field name="revision" string="Connection revision"/></group>
              <separator string="Available models"/><field name="models_catalog" nolabel="1"/>
              <separator string="Tool discovery"/><field name="toolsets" nolabel="1"/>
              <separator string="API capabilities"/><field name="capabilities" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_engines" model="ir.actions.act_window"><field name="name">Hermes engines</field><field name="res_model">ai.agent.engine</field><field name="view_mode">list,form</field><field name="context">{'default_connection_mode': 'local', 'default_name': 'Local Hermes', 'default_url': 'http://127.0.0.1:8643', 'default_management_url': 'http://127.0.0.1:9120'}</field></record>
  <record id="skill_list" model="ir.ui.view"><field name="name">ai.agent.skill.list</field><field name="model">ai.agent.skill</field><field name="arch" type="xml"><list><field name="name"/><field name="description"/><field name="state"/><field name="revision" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/></list></field></record>
  <record id="skill_form" model="ir.ui.view">
    <field name="name">ai.agent.skill.form</field><field name="model">ai.agent.skill</field>
    <field name="arch" type="xml"><form string="Skill">
      <header><button name="action_approve" string="Approve skill" type="object" class="btn-primary" invisible="state == 'approved'" confirm="Approve these instructions for assigned agents? Editing them requires a new review."/><field name="state" widget="statusbar"/></header>
      <sheet>
        <div class="oe_title"><label for="name" string="Skill name"/><h1><field name="name" placeholder="e.g. Summarize a sales opportunity"/></h1></div>
        <group><field name="description" string="Purpose" placeholder="Describe what this skill helps the agent do"/><field name="company_id" groups="base.group_multi_company" readonly="id"/></group>
        <separator string="Instructions"/>
        <p class="text-muted">Describe the goal, steps and expected answer. Instructions guide the agent; they do not grant permission to change records.</p>
        <field name="instructions" nolabel="1" placeholder="Goal: explain the opportunity. Steps: review permitted information, summarize it, and identify missing evidence. Output: a short summary and suggested next steps."/>
        <group string="Review"><field name="revision" string="Instruction revision"/></group>
      </sheet><chatter/>
    </form></field>
  </record>
  <record id="action_skills" model="ir.actions.act_window"><field name="name">Skills</field><field name="res_model">ai.agent.skill</field><field name="view_mode">list,form</field></record>
  <record id="source_list" model="ir.ui.view"><field name="name">ai.agent.source.list</field><field name="model">ai.agent.source</field><field name="arch" type="xml"><list><field name="name"/><field name="kind" string="Source type"/><field name="state"/><field name="active"/><field name="revision" optional="hide"/><field name="filename" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/></list></field></record>
  <record id="source_form" model="ir.ui.view">
    <field name="name">ai.agent.source.form</field><field name="model">ai.agent.source</field>
    <field name="arch" type="xml"><form string="Knowledge source">
      <header><button name="action_prepare" string="Reprocess content" type="object" invisible="not id or (not text and not file)"/><button name="action_access_rights" string="Access rights" type="object" groups="base.group_system" invisible="not id"/><field name="state" widget="statusbar"/></header>
      <sheet>
        <div class="oe_title"><label for="name" string="Source name"/><h1><field name="name" placeholder="e.g. Employee handbook"/></h1></div>
        <group><group string="Source"><field name="kind" string="Source type" widget="radio" options="{'horizontal': true}"/><field name="filename" invisible="1"/><field name="file" string="Upload file" filename="filename" invisible="kind != 'file'"/><field name="active" string="Available"/></group><group string="Ownership"><field name="company_id" groups="base.group_multi_company" readonly="id"/><field name="create_uid" string="Created by" invisible="not id"/></group></group>
        <p class="text-muted" invisible="kind != 'file'">Upload a text-based PDF, TXT, Markdown or CSV file. Content is prepared when you save. Scanned PDFs require OCR, which is not available yet.</p>
        <separator string="Reference content" invisible="kind != 'text'"/><field name="text" nolabel="1" invisible="kind != 'text'" placeholder="Paste the reference information the agent should use."/>
        <div class="alert alert-warning" role="alert" invisible="state != 'failed'"><field name="status_message" nolabel="1"/></div>
        <div class="alert alert-success" role="status" invisible="state != 'ready'">Content is ready. Assigned agents can use it only when the requesting user has permission to read this source.</div>
        <notebook>
          <page string="Extracted content" invisible="not extracted_text"><p class="text-muted">Check that the file was read correctly. This preview is read-only.</p><field name="extracted_text" nolabel="1"/></page>
          <page string="Access &amp; details"><p class="text-muted">Access rights and record rules control who can read this source. System administrators can grant access to existing user groups or add restrictions through security settings.</p><group><field name="revision" string="Content revision"/><field name="write_date" string="Last updated" invisible="not id"/></group></page>
        </notebook>
      </sheet>
    </form></field>
  </record>
  <record id="action_sources" model="ir.actions.act_window"><field name="name">Sources</field><field name="res_model">ai.agent.source</field><field name="view_mode">list,form</field></record>
</odoo>
