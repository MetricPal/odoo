<odoo>
  <record id="conversation_list" model="ir.ui.view"><field name="name">ai.agent.conversation.list</field><field name="model">ai.agent.conversation</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="agent_id"/><field name="user_id" optional="hide"/><field name="write_date" optional="hide"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="conversation_form" model="ir.ui.view"><field name="name">ai.agent.conversation.form</field><field name="model">ai.agent.conversation</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_ask" string="Ask AI" type="object" class="btn-primary"/></header><sheet><h1><field name="name"/></h1><group><field name="agent_id"/><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/></group><field name="run_ids"><list create="0" edit="0" delete="0"><field name="prompt"/><field name="state"/><field name="answer" optional="show"/><field name="error_message" optional="hide"/></list></field></sheet></form></field></record>
  <record id="action_conversations" model="ir.actions.act_window"><field name="name">Conversations</field><field name="res_model">ai.agent.conversation</field><field name="view_mode">list,form</field><field name="domain">[('user_id', '=', uid)]</field></record>
  <record id="run_list" model="ir.ui.view"><field name="name">ai.agent.run.list</field><field name="model">ai.agent.run</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="agent_id"/><field name="state"/><field name="create_date"/><field name="user_id" optional="hide"/><field name="input_tokens" optional="hide"/><field name="output_tokens" optional="hide"/><field name="runtime_model" optional="hide"/><field name="runtime_provider" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/></list></field></record>
  <record id="run_form" model="ir.ui.view"><field name="name">ai.agent.run.form</field><field name="model">ai.agent.run</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_stop" string="Stop" type="object" invisible="state not in ['queued', 'running', 'submitting']" confirm="Stop this request? Hermes stops cooperatively; already accepted work may incur cost."/><button name="action_reconcile" string="Check remote outcome" type="object" groups="ai_agent.group_manager" invisible="state != 'uncertain'"/><field name="state" widget="statusbar"/></header><sheet><h1><field name="name"/></h1><group><field name="agent_id"/><field name="user_id"/><field name="conversation_id"/><field name="error_message" invisible="not error_message"/></group><notebook><page string="Conversation"><h3>Question</h3><field name="prompt"/><h3>Answer</h3><field name="answer"/></page><page string="Activity"><field name="event_ids"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="kind"/><field name="detail"/></list></field><group><field name="started_at"/><field name="finished_at"/><field name="input_tokens"/><field name="output_tokens"/><field name="runtime_provider"/><field name="runtime_model"/></group></page><page string="Technical evidence" groups="ai_agent.group_manager"><group><field name="request_key"/><field name="remote_id"/><field name="configuration_hash"/><field name="context_hash"/></group><field name="request_payload"/></page></notebook></sheet></form></field></record>
  <record id="run_search" model="ir.ui.view"><field name="name">ai.agent.run.search</field><field name="model">ai.agent.run</field><field name="arch" type="xml"><search><field name="name"/><field name="agent_id"/><filter name="pending" string="In progress" domain="[('state', 'in', ['queued', 'running', 'submitting'])]"/><filter name="attention" string="Needs attention" domain="[('state', 'in', ['failed', 'uncertain'])]"/><filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/><group><filter name="by_agent" string="Agent" context="{'group_by': 'agent_id'}"/><filter name="by_state" string="Status" context="{'group_by': 'state'}"/></group></search></field></record>
  <record id="action_activity" model="ir.actions.act_window"><field name="name">Activity</field><field name="res_model">ai.agent.run</field><field name="view_mode">list,form</field></record>
</odoo>
