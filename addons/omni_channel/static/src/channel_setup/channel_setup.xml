<templates xml:space="preserve">
  <t t-name="omni_channel.ChannelSetup" t-inherit="web.FormView" t-inherit-mode="primary">
    <xpath expr="//Layout" position="attributes">
      <attribute name="className">'o_component_with_search_panel o_omni_setup_content'</attribute>
    </xpath>
    <xpath expr="//t[@t-set-slot='control-panel-buttons']" position="replace">
      <t t-set-slot="control-panel-buttons"><t t-call="web.FormView.DialogButtons"/></t>
    </xpath>
    <xpath expr="//t[@t-component='this.props.Renderer'][@readonly]" position="replace">
      <aside class="o_search_panel o_search_panel_wrap o_omni_setup_steps flex-grow-0 flex-shrink-0 pb-5 ps-3 overflow-auto position-relative" aria-label="Channel setup steps">
        <h3 class="mt-3">Create channel</h3>
        <nav class="d-flex flex-column gap-1 pe-2">
          <button t-foreach="this.steps" t-as="step" t-key="step_index" type="button"
                  class="o_omni_setup_step d-flex align-items-start gap-2 text-start border-0 rounded p-3"
                  t-att-class="{ current: this.setupState.step === step_index, completed: this.setupState.completed.includes(step_index) }"
                  t-att-aria-current="this.setupState.step === step_index ? 'step' : false"
                  t-att-disabled="this.setupState.busy || (step_index !== this.setupState.step &amp;&amp; !this.setupState.completed.includes(step_index))" t-on-click="() => this.selectSetupStep(step_index)">
            <span class="o_omni_step_circle rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0">
              <span t-if="this.setupState.completed.includes(step_index) and this.setupState.step !== step_index" aria-label="Completed">✓</span>
              <t t-else="" t-out="step_index + 1"/>
            </span>
            <span><strong t-out="step.title"/><small class="d-block mt-1 text-muted" t-out="step.hint"/></span>
          </button>
        </nav>
      </aside>
      <div class="o_search_panel_resize h-100 px-2 opacity-0 opacity-100-hover" t-on-click.stop.prevent="" t-on-pointerdown.stop.prevent="this.resizeSteps">
        <span class="border-start border-2 border-primary h-100 d-block"/>
      </div>
      <div class="o_form_renderer d-flex flex-nowrap h-100 flex-grow-1 min-w-0 o_omni_setup" t-att-data-setup-step="this.setupState.step">
        <div class="o_form_sheet_bg o_omni_setup_form overflow-auto o-scrollbar-thin min-w-0">
          <t t-component="this.props.Renderer" record="this.model.root" Compiler="this.props.Compiler" archInfo="this.archInfo"
             readonly="this.props.readonly or !this.canEdit" translateAlert="this.translateAlert" onNotebookPageChange.bind="this.onNotebookPageChange"/>
          <div class="o_omni_setup_footer d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 border-top">
            <button class="btn btn-secondary" t-att-disabled="this.setupState.step === 0 || this.setupState.busy" t-on-click="() => this.goToStep(this.setupState.step - 1)">Back</button>
            <span class="o_omni_setup_save_hint text-muted align-self-center">Changes are saved when you continue.</span>
            <t t-if="this.setupState.step === 2 &amp;&amp; !this.model.root.data.is_telegram &amp;&amp; !this.model.root.data.setup_connection_ready">
              <button class="btn btn-primary" t-att-disabled="this.setupState.busy" t-on-click="this.deferReceiving">Next: Branding</button>
            </t>
            <button t-elif="this.setupState.step &lt; this.steps.length - 1" class="btn btn-primary" t-att-disabled="this.setupState.busy || (this.setupState.step === 2 &amp;&amp; !this.model.root.data.setup_connection_ready)" t-on-click="() => this.goToStep(this.setupState.step + 1)">Next: <t t-out="this.steps[this.setupState.step + 1].title"/></button>
            <t t-elif="!this.setupState.completed.includes(2) || !this.model.root.data.setup_connection_ready">
              <button class="btn btn-secondary" t-att-disabled="this.setupState.busy" t-on-click="() => this.goToStep(2)">Finish receiving setup</button>
              <button class="btn btn-primary" t-att-disabled="this.setupState.busy" t-on-click="this.saveSetupDraft">Save draft</button>
            </t>
            <button t-else="" class="btn btn-primary" t-att-disabled="this.setupState.busy || (this.model.root.data.is_telegram &amp;&amp; this.model.root.data.setup_test_send_state !== 'sent')" t-on-click="() => this.finishSetup()">Finish setup</button>
          </div>
        </div>
        <aside class="o-mail-ChatterContainer o-mail-Form-chatter o-aside w-print-100" aria-label="Setup guidance">
          <div class="o-mail-Chatter w-100 h-100 flex-grow-1 d-flex flex-column bg-inherit overflow-auto o-scrollbar-thin">
            <div class="o-mail-Chatter-content d-flex flex-column flex-grow-1 bg-inherit p-3">
              <h3>About this step</h3><p t-out="this.steps[this.setupState.step].about"/>
              <t t-if="this.setupState.step === 1">
                <t t-if="this.model.root.data.setup_connection_mode === 'new'">
                  <p>Connect a new account using its credentials.</p>
                  <ol t-if="this.model.root.data.is_telegram">
                    <li>Paste the token from your bot’s administrator into <strong>Bot token</strong>.</li>
                    <li>Leave <strong>Webhook secret</strong> empty to generate one.</li>
                    <li>Click <strong>Verify bot</strong>. Check the bot details, then continue.</li>
                  </ol>
                  <p>The bot ID is filled automatically. You do not need to enter the database name.</p>
                </t>
                <t t-else="">
                  <p>Select a saved connection. Its token and webhook secret are reused; you do not need to enter them again.</p>
                  <p>Click <strong>Verify bot</strong> to check a Telegram connection, then continue through the remaining steps.</p>
                  <p>If the list shows <strong>No records</strong>, clear your search or choose <strong>Create new connection</strong>. The list only includes accounts for the selected company, team and channel type.</p>
                </t>
                <p>A bot already assigned to another channel cannot be reused here. Switching choices clears unsaved credentials.</p>
              </t>
              <t t-if="this.setupState.step === 2">
                <p t-if="this.model.root.data.is_telegram">Enter a public HTTPS URL (e.g. Tailscale Funnel). Connect Telegram registers the webhook.</p>
                <p t-else="">Enter a public HTTPS webhook URL, then enable receiving.</p>
              </t>
              <t t-if="this.setupState.step === 3">
                <p>The display name and description help your colleagues recognize this channel in Odoo. They do not change the provider account’s public profile or credentials.</p>
              </t>
              <t t-if="this.setupState.step === 4">
                <p>Enter your personal Telegram user ID and send the test message. Then finish setup.</p>
              </t>
              <div class="alert alert-warning" t-if="this.model.root.data.channel_type_id &amp;&amp; !this.model.root.data.adapter_ready">This channel type needs an installed provider adapter before it can connect, send or receive. You can save its configuration now.</div>
              <p t-if="this.setupState.step > 0 &amp;&amp; this.setupState.step &lt; 2" class="text-muted">Setup does not send a test message or activate delivery automatically.</p>
            </div>
          </div>
        </aside>
      </div>
    </xpath>
  </t>
</templates>
