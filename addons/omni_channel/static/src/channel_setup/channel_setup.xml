<templates xml:space="preserve">
  <!-- Create channel as a standard Odoo form: breadcrumbs in the control panel, a form header with Back / Next on
       the left and the steps as a status bar on the right, the step guide as an info box, then the form sheet. -->
  <t t-name="omni_channel.ChannelSetup" t-inherit="web.FormView" t-inherit-mode="primary">
    <xpath expr="//t[@t-set-slot='control-panel-buttons']" position="replace">
      <t t-set-slot="control-panel-buttons"><t t-call="web.FormView.DialogButtons"/></t>
    </xpath>
    <xpath expr="//t[@t-component='this.props.Renderer'][@readonly]" position="replace">
      <div class="o_omni_setup" t-att-data-setup-step="this.setupState.step">
        <div class="o_form_sheet_bg o_omni_setup_top">
          <div class="o_form_statusbar o_omni_setup_header d-flex flex-wrap justify-content-between gap-2 pb-2">
            <div class="o_statusbar_buttons d-flex flex-wrap align-items-center gap-1">
              <button class="btn btn-secondary" t-att-disabled="this.setupState.step === 0 || this.setupState.busy" t-on-click="() => this.goToStep(this.setupState.step - 1)">Back</button>
              <t t-if="this.setupState.step === 2 &amp;&amp; !this.model.root.data.is_telegram &amp;&amp; !this.model.root.data.setup_connection_ready">
                <button class="btn btn-primary" t-att-disabled="this.setupState.busy" t-on-click="this.deferReceiving">Next: Branding</button>
              </t>
              <button t-elif="this.setupState.step &lt; this.steps.length - 1" class="btn btn-primary" t-att-disabled="this.setupState.busy || (this.setupState.step === 2 &amp;&amp; !this.model.root.data.setup_connection_ready)" t-on-click="() => this.goToStep(this.setupState.step + 1)">Next: <t t-out="this.steps[this.setupState.step + 1].title"/></button>
              <t t-elif="!this.setupState.completed.includes(2) || !this.model.root.data.setup_connection_ready">
                <button class="btn btn-secondary" t-att-disabled="this.setupState.busy" t-on-click="() => this.goToStep(2)">Finish receiving setup</button>
                <button class="btn btn-primary" t-att-disabled="this.setupState.busy" t-on-click="this.saveSetupDraft">Save draft</button>
              </t>
              <button t-else="" class="btn btn-primary" t-att-disabled="this.setupState.busy || (this.model.root.data.is_telegram &amp;&amp; this.model.root.data.setup_test_send_state !== 'sent')" t-on-click="() => this.finishSetup()">Finish setup</button>
            </div>
            <!-- Odoo's status bar markup: the steps are listed last to first, the status bar CSS shows them in order. -->
            <div class="o_field_widget o_field_statusbar">
              <div class="o_statusbar_status o_omni_setup_steps" role="radiogroup" aria-label="Channel setup steps">
                <div t-foreach="this.stepsReversed" t-as="step" t-key="step.index" class="o_arrow_button_wrap d-flex">
                  <button type="button" class="btn btn-secondary o_arrow_button o_omni_setup_step"
                          t-att-class="{ o_first: step_first, o_last: step_last, o_arrow_button_current: this.setupState.step === step.index, completed: this.setupState.completed.includes(step.index) }"
                          role="radio" t-att-aria-checked="(this.setupState.step === step.index).toString()"
                          t-att-aria-current="this.setupState.step === step.index ? 'step' : false"
                          t-att-disabled="this.setupState.busy || step.index === this.setupState.step || !this.setupState.completed.includes(step.index)"
                          t-on-click="() => this.selectSetupStep(step.index)" t-out="step.title"/>
                </div>
              </div>
            </div>
          </div>
          <div class="alert alert-info o_omni_setup_guide" role="status">
            <p t-out="this.steps[this.setupState.step].about"/>
            <t t-if="this.setupState.step === 1">
              <t t-if="this.model.root.data.setup_connection_mode === 'new'">
                <p t-if="this.model.root.data.is_telegram">Paste your bot token from <strong>BotFather</strong>, then click <strong>Verify bot</strong>. Bot details are filled automatically.</p>
                <p t-else="">Enter your provider’s credentials.</p>
              </t>
              <t t-else="">
                <p>Select a saved connection to reuse its credentials.</p>
                <p t-if="this.model.root.data.is_telegram">Click <strong>Verify bot</strong>, then continue.</p>
                <p><strong>No records</strong>? Clear your search or choose <strong>Create new connection</strong>.</p>
              </t>
              <p t-if="this.model.root.data.is_telegram">A bot assigned to another channel cannot be reused.</p>
              <p>Switching choices clears unsaved credentials.</p>
            </t>
            <t t-if="this.setupState.step === 2">
              <p t-if="this.model.root.data.is_telegram">Enter a public HTTPS URL (e.g. Tailscale Funnel). Connect Telegram registers the webhook.</p>
              <p t-else="">Enter a public HTTPS webhook URL, then enable receiving.</p>
            </t>
            <t t-if="this.setupState.step === 3">
              <p>The display name and description help your colleagues recognize this channel in Odoo. They do not change the provider account’s public profile or credentials.</p>
            </t>
            <t t-if="this.setupState.step === 4">
              <p>Enter your personal Telegram user ID and send the test message. Then finish setup.</p>
            </t>
            <p t-if="this.setupState.step > 0 &amp;&amp; this.setupState.step &lt; 2">Setup does not send a test message or activate delivery automatically.</p>
          </div>
          <div class="alert alert-warning" role="alert" t-if="this.model.root.data.channel_type_id &amp;&amp; !this.model.root.data.adapter_ready">This channel type needs an installed provider adapter before it can connect, send or receive. You can save its configuration now.</div>
        </div>
        <t t-component="this.props.Renderer" record="this.model.root" Compiler="this.props.Compiler" archInfo="this.archInfo"
           readonly="this.props.readonly or !this.canEdit" translateAlert="this.translateAlert" onNotebookPageChange.bind="this.onNotebookPageChange"/>
      </div>
    </xpath>
  </t>
</templates>
