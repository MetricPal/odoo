<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="channel_kanban" model="ir.ui.view">
    <field name="name">channel_kanban</field>
    <field name="model">omni.channel</field>
    <field name="arch" type="xml">
      <kanban can_open="false" js_class="omni_channel_kanban" records_draggable="false" groups_draggable="false" quick_create="false" group_create="false" group_edit="false" group_delete="false">
        <field name="selected_sender_id"/>
        <templates>
          <t t-name="card">
            <div name="channel_card_standard" class="d-flex flex-column h-100"><div class="d-flex justify-content-between align-items-start gap-2">
    <div><field name="name" class="fw-bold fs-5"/></div>
    <div class="text-end"><div class="mb-1"><field name="channel_type_id" widget="badge"/></div><div class="mb-1"><field name="purpose_id" widget="badge"/></div><field name="readiness" widget="badge"/></div>
  </div>
  <field name="company_id" class="text-muted small mb-2" groups="base.group_multi_company"/>
  <field name="setup_step_total" invisible="1"/>
  <field name="setup_completed_steps" widget="omni_setup_progress" class="my-0"/>
  <div class="text-end mt-auto pt-3">
    <button name="action_continue_setup" type="object" string="Start setup" class="btn btn-secondary" invisible="setup_completed_steps != 0" groups="omni_channel.group_omni_manager"/>
    <button name="action_continue_setup" type="object" string="Continue setup" class="btn btn-secondary" invisible="setup_completed_steps == 0 or setup_completed_steps == 5" groups="omni_channel.group_omni_manager"/>
    <button name="action_open_channel" type="object" string="Open channel" class="btn btn-secondary" invisible="setup_completed_steps != 5"/>
  </div>
</div></t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="channel_list" model="ir.ui.view">
    <field name="name">channel_list</field>
    <field name="model">omni.channel</field>
    <field name="arch" type="xml">
      <list js_class="omni_channel_list">
        <field name="name"/>
        <field name="purpose_id"/>
        <field name="channel_type_id"/>
        <field name="readiness" widget="badge"/>
        <field name="setup_step_total" column_invisible="True"/>
        <field name="setup_completed_steps" string="Progress" widget="omni_setup_progress"/>
        <button name="action_continue_setup" type="object" string="Start setup" invisible="setup_completed_steps != 0" groups="omni_channel.group_omni_manager"/><button name="action_continue_setup" type="object" string="Continue setup" invisible="setup_completed_steps == 0 or setup_completed_steps == 5" groups="omni_channel.group_omni_manager"/>
        <field name="selected_sender_id" optional="hide"/>
        <field name="sender_count" optional="hide"/>
        <field name="endpoint_count" optional="hide"/>
        <field name="connection_status" optional="hide"/>
        <field name="inbound_status" optional="hide"/>
        <field name="active" optional="hide"/>
        <field name="company_id" optional="hide" groups="base.group_multi_company"/>
        <button name="action_open_channel" type="object" string="Open channel" invisible="setup_completed_steps != 5"/>
      </list>
    </field>
  </record>
  <record id="channel_search" model="ir.ui.view">
    <field name="name">channel_search</field>
    <field name="model">omni.channel</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="purpose_id"/>
        <field name="channel_type_id"/>
        <filter name="messaging" string="Messaging" domain="[('channel_type_id.category', '=', 'messaging')]"/>
        <filter name="social" string="Social" domain="[('channel_type_id.category', '=', 'social')]"/>
        <filter name="other" string="Other" domain="[('channel_type_id.category', '=', 'other')]"/>
        <separator/>
        <filter name="setup_incomplete" string="Incomplete setup" domain="[('setup_completed_steps', '&lt;', 5)]"/>
        <separator/>
        <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
        <separator/>
        <filter name="by_purpose" string="Communication team" context="{'group_by':'purpose_id'}"/>
        <filter name="by_type" string="Channel type" context="{'group_by':'channel_type_id'}"/>
        <filter name="by_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
        <searchpanel view_types="kanban,list">
          <field name="purpose_id" string="Communication teams" select="one" enable_counters="1" expand="1"/>
          <field name="channel_type_id" string="Channel types" select="one" enable_counters="1" expand="1"/>
        </searchpanel>
      </search>
    </field>
  </record>
  <record id="channel_form" model="ir.ui.view">
    <field name="name">channel_form</field>
    <field name="model">omni.channel</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_select_sender" type="object" string="Select runtime sender" class="oe_highlight" groups="omni_channel.group_omni_manager"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box" groups="base.group_system">
            <button name="action_connections" type="object" string="Connections" icon="fa-plug" class="oe_stat_button" invisible="not id"/>
            <button name="action_messages" type="object" string="Messages" icon="fa-envelope" class="oe_stat_button" invisible="not id"/>
          </div>
          <div class="d-flex justify-content-end mb-2" role="status" aria-live="polite">
            <field name="readiness" widget="badge" nolabel="1" decoration-success="readiness == 'ready'" decoration-warning="readiness == 'unconfigured'" decoration-danger="readiness in ('unavailable', 'blocked')"/>
          </div>
          <div><field name="adapter_ready" invisible="1"/><div class="alert alert-warning" role="status" invisible="not channel_type_id or adapter_ready">This channel type has no installed provider adapter. You can save its configuration, but connecting, sending and receiving are unavailable until a compatible adapter is installed.</div></div>
          <div class="oe_title">
            <label for="name"/>
            <h1>
              <field name="name" placeholder="Team channel"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="purpose_id"/>
              <field name="channel_type_id"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="selected_sender_id"/>
              <field name="endpoint_count"/>
              <field name="connection_status"/>
              <field name="inbound_status"/>
              <field name="active"/>
            </group>
          </group>
          <div class="text-muted mb-3" invisible="not channel_type_id or not adapter_ready">A provider adapter is installed. Configure its connection and verify the identities before activation. An installed adapter does not mean the connection is ready.</div>
          <div class="alert alert-info" role="status">Configure a connection, then add senders and inbound endpoints below. Activation requires verification and explicit confirmation.</div>
          <notebook>
            <page string="Outbound senders">
              <field name="sender_ids" context="{'default_channel_id': id}" readonly="not id">
                <list>
                  <field name="name"/>
                  <field name="account_id"/>
                  <field name="external_key" optional="hide"/>
                  <field name="is_selected"/>
                  <field name="health"/>
                  <field name="health_checked_at"/>
                </list>
              </field>
            </page>
            <page string="Inbound endpoints">
              <field name="endpoint_ids" context="{'default_channel_id': id}" readonly="not id">
                <list>
                  <field name="name"/>
                  <field name="purpose_id"/>
                  <field name="account_id"/>
                  <field name="external_key" optional="hide"/>
                  <field name="state"/>
                  <field name="health"/>
                  <field name="active"/>
                </list>
              </field>
            </page>
            <page string="Operations" name="operations">
              <group>
                <field name="approval_type_id"/>
              </group>
              <div groups="base.group_system">
                <button name="action_policies" type="object" string="Receiving policies" class="btn-secondary" invisible="not id"/>
                <details class="mt-3">
                  <summary>Technical Details</summary>
                  <button name="action_delivery_logs" type="object" string="Delivery logs" invisible="not id"/>
                  <button name="action_intake_logs" type="object" string="Intake logs" invisible="not id"/>
                  <button name="action_audit_logs" type="object" string="Purpose audit history" invisible="not id"/>
                  <button name="action_recipient_authorizations" type="object" string="Recipient authorization" invisible="not id"/>
                </details>
              </div>
            </page>
            <page string="Alerts" name="alerts">
              <group>
                <field name="attention"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="channel_setup_form" model="ir.ui.view">
    <field name="name">omni.channel.setup.form</field><field name="model">omni.channel</field>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <form string="Create channel" js_class="omni_channel_setup" create="0" delete="0">
        <sheet>
          <field name="adapter_ready" invisible="1"/>
          <field name="setup_completed_step_ids" invisible="1"/>
          <field name="setup_receiving_deferred" invisible="1"/>
          <field name="setup_receiving_ready" invisible="1"/>
          <field name="setup_connection_ready" invisible="1"/>
          <field name="setup_endpoint_health" invisible="1"/>
          <field name="setup_has_bindings" invisible="1"/>
          <field name="setup_callback_url" invisible="1"/>
          <field name="setup_sender_id" invisible="1"/>
          <field name="setup_endpoint_id" invisible="1"/>
          <field name="setup_policy_id" invisible="1"/>
          <field name="setup_policy_state" invisible="1"/>
          <div class="o_omni_setup_stage o_omni_setup_stage_0">
            <group><field name="name" placeholder="Sales enquiries"/><field name="channel_type_id" readonly="setup_has_bindings"/><field name="company_id" readonly="setup_has_bindings"/><field name="purpose_id" readonly="setup_has_bindings"/></group>
          </div>
          <div class="o_omni_setup_stage o_omni_setup_stage_1">
            <field name="setup_connection_mode" widget="radio" class="mb-3" options="{'horizontal': True}" readonly="setup_has_bindings"/>
            <group invisible="setup_connection_mode != 'existing'"><field name="setup_account_id" string="Connection" placeholder="Select a saved connection" required="setup_connection_mode == 'existing'" readonly="setup_has_bindings" options="{'no_create': True, 'no_open': True}" domain="[('company_id', '=', company_id), ('purpose_id', '=', purpose_id), ('channel_type_id', '=', channel_type_id), ('active', '=', True)]"/></group>
            <div name="setup_credentials"/>
            <p name="setup_provider_unavailable" class="text-muted">Guided credential entry requires a supported provider adapter.</p>
          </div>
          <div class="o_omni_setup_stage o_omni_setup_stage_2">
            <group><field name="setup_endpoint_state" string="Receiving status"/></group>
            <group><field name="setup_callback_preview" class="border rounded px-2 py-2"/></group>
            <div name="setup_primary_connection"/>
            <div name="setup_receiving_actions" class="d-flex flex-wrap gap-2 mb-3">
              <button name="action_setup_enable_receiving" type="object" string="Enable receiving" class="btn-primary" invisible="not setup_endpoint_id or not setup_callback_url or setup_endpoint_state == 'enabled'" confirm="Enable receiving under the displayed retention policy? This does not register the provider webhook or send a message."/>
              <button name="action_messages" type="object" string="View received messages" class="btn-secondary" invisible="setup_endpoint_state != 'enabled'"/>
            </div>
            <div name="setup_receiving_settings" class="mt-3">
                <button name="action_setup_verify_webhook" type="object" string="Verify webhook" class="btn-secondary mb-3"/>
                <div name="setup_provider_receiving"/>
                <group string="Message retention">
                  <field name="setup_payload_days" readonly="setup_policy_state != 'draft'"/><field name="setup_message_days" readonly="setup_policy_state != 'draft'"/><field name="setup_blocked_days" readonly="setup_policy_state != 'draft'"/>
                </group>
            </div>
          </div>
          <div class="o_omni_setup_stage o_omni_setup_stage_3">
            <p>Choose how your team recognizes this channel inside Odoo.</p>
            <group><field name="name" string="Channel display name"/><field name="setup_description"/></group>
            <p class="text-muted">The bot’s public name and profile image are managed in the provider account.</p>
          </div>
          <div class="o_omni_setup_stage o_omni_setup_stage_4">
            <p invisible="setup_connection_ready">Return to Connect &amp; verify to connect this channel first.</p>
            <div invisible="not setup_connection_ready">
            <div name="setup_provider_activation"/>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_channel_setup" model="ir.actions.act_window">
    <field name="name">Create channel</field><field name="res_model">omni.channel</field>
    <field name="view_mode">form</field><field name="view_id" ref="channel_setup_form"/>
  </record>
  <record id="action_channels" model="ir.actions.act_window">
    <field name="name">Channels</field>
    <field name="res_model">omni.channel</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="channel_kanban"/>
    <field name="search_view_id" ref="channel_search"/>
    <field name="limit">80</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first team channel</p>
      <p>Configure a connection, then add senders and inbound endpoints below. Activation requires verification and explicit confirmation.</p>
    </field>
  </record>
  <record id="omni_account_list" model="ir.ui.view">
    <field name="name">omni_account_list</field>
    <field name="model">omni.account</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="channel_type_id"/>
        <field name="external_account_key" optional="hide"/>
        <field name="namespace" optional="hide"/>
        <field name="purpose_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="omni_account_form" model="ir.ui.view">
    <field name="name">omni_account_form</field>
    <field name="model">omni.account</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <p class="text-muted">Configure a connection, then add senders and inbound endpoints below. Activation requires verification and explicit confirmation.</p>
          <group>
            <field name="name" placeholder="Team channel"/>
            <field name="channel_type_id"/>
            <field name="external_account_key" string="Provider account ID" placeholder="Provider-issued ID; never invent a value"/>
            <field name="namespace" string="Account identity scope" placeholder="Provider-specific account scope"/>
            <field name="purpose_id"/>
            <field name="company_id"/>
            <field name="active"/>
            <field name="credential_reference" string="Provisioned secret reference" groups="omni_channel.group_omni_manager" placeholder="OMNI_SECRET_MARKETING_BOT"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_account" model="ir.actions.act_window">
    <field name="name">Connections</field>
    <field name="res_model">omni.account</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Connect your team’s provider account</p>
      <p>Configure a connection, then add senders and inbound endpoints below. Activation requires verification and explicit confirmation.</p>
    </field>
  </record>
  <record id="omni_outbound_sender_list" model="ir.ui.view">
    <field name="name">omni_outbound_sender_list</field>
    <field name="model">omni.outbound.sender</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="channel_id"/>
        <field name="account_id"/>
        <field name="external_key" optional="hide"/>
        <field name="is_selected"/>
        <field name="health"/>
        <field name="health_checked_at"/>
      </list>
    </field>
  </record>
  <record id="omni_outbound_sender_form" model="ir.ui.view">
    <field name="name">omni_outbound_sender_form</field>
    <field name="model">omni.outbound.sender</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_check_health" type="object" string="Check health" groups="omni_channel.group_omni_manager"/>
          <button name="action_deactivate" type="object" string="Deactivate" invisible="not is_selected" groups="omni_channel.group_omni_manager" confirm="Disable this channel's runtime sender?"/>
        </header>
        <sheet>
          <p class="text-muted">Configure a connection, then add senders and inbound endpoints below. Activation requires verification and explicit confirmation.</p>
          <group>
            <field name="name"/>
            <field name="channel_id"/>
            <field name="account_id" domain="[('purpose_id', '=', purpose_id), ('company_id', '=', company_id), ('channel_type_id', '=', channel_type_id)]" context="{'default_company_id': company_id, 'default_purpose_id': purpose_id, 'default_channel_type_id': channel_type_id}"/>
            <field name="is_selected"/>
            <field name="health"/>
            <field name="health_checked_at"/>
            <field name="company_id" invisible="1"/>
            <field name="purpose_id" invisible="1"/>
            <field name="channel_type_id" invisible="1"/>
            <field name="active"/>
            <field name="health_message"/>
          </group>
          <details>
            <summary>Technical Details</summary>
            <group>
              <field name="external_key"/>
            </group>
          </details>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_outbound_sender" model="ir.actions.act_window">
    <field name="name">Outbound Senders</field>
    <field name="res_model">omni.outbound.sender</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Choose which account sends replies</p>
      <p>Create a sender for your connection, then select and verify it from the channel settings.</p>
    </field>
  </record>
  <record id="omni_inbound_endpoint_list" model="ir.ui.view">
    <field name="name">omni_inbound_endpoint_list</field>
    <field name="model">omni.inbound.endpoint</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="channel_id"/>
        <field name="purpose_id"/>
        <field name="account_id"/>
        <field name="external_key" optional="hide"/>
        <field name="state"/>
        <field name="health"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="omni_inbound_endpoint_form" model="ir.ui.view">
    <field name="name">omni_inbound_endpoint_form</field>
    <field name="model">omni.inbound.endpoint</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <p class="text-muted">Create and save an endpoint for the account that will receive messages. Activate a receiving policy for its channel, then use Verify and enable intake to allow Odoo to receive messages. The provider must also be configured to send messages to this endpoint’s webhook URL. This screen does not register the URL with the provider; that setup currently requires a deployment administrator.</p>
          <group>
            <field name="name"/>
            <field name="channel_id"/>
            <field name="account_id" domain="[('purpose_id', '=', purpose_id), ('company_id', '=', company_id), ('channel_type_id', '=', channel_type_id)]" context="{'default_company_id': company_id, 'default_purpose_id': purpose_id, 'default_channel_type_id': channel_type_id}"/>
            <field name="external_key" string="Receiving identity"/>
            <field name="state"/>
            <field name="health"/>
            <field name="health_checked_at"/>
            <field name="company_id" invisible="1"/>
            <field name="purpose_id"/>
            <field name="channel_type_id" invisible="1"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_inbound_endpoint" model="ir.actions.act_window">
    <field name="name">Inbound Endpoints</field>
    <field name="res_model">omni.inbound.endpoint</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Connect incoming messages to a channel</p>
      <p>Choose a connection and an active receiving policy. Verification and explicit activation are required.</p>
    </field>
  </record>
  <record id="omni_purpose_list" model="ir.ui.view">
    <field name="name">omni_purpose_list</field>
    <field name="model">omni.purpose</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="user_ids"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="omni_purpose_form" model="ir.ui.view">
    <field name="name">omni_purpose_form</field>
    <field name="model">omni.purpose</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <p class="text-muted">A communication team controls who can see and work on its channels. Example: Customer Support. Add internal users who already have the Omni Operator or Administrator role and company access. Team membership alone does not grant an application role.</p>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="user_ids" widget="many2many_tags"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_purpose" model="ir.actions.act_window">
    <field name="name">Communication Teams</field>
    <field name="res_model">omni.purpose</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Communication Teams</p>
    </field>
  </record>
  <record id="omni_channel_type_list" model="ir.ui.view">
    <field name="name">omni_channel_type_list</field>
    <field name="model">omni.channel.type</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="name"/>
        <field name="category"/>
        <field name="adapter_ready"/>
      </list>
    </field>
  </record>
  <record id="omni_channel_type_form" model="ir.ui.view">
    <field name="name">omni_channel_type_form</field>
    <field name="model">omni.channel.type</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <p class="text-muted">This catalog lists possible providers. Adapter installed means integration code is available; it does not mean an account is connected or sending is enabled.</p>
          <group>
            <field name="name"/>
            <field name="category"/>
            <field name="adapter_ready"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_channel_type" model="ir.actions.act_window">
    <field name="name">Channel Catalog</field>
    <field name="res_model">omni.channel.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Channel Catalog</p>
    </field>
  </record>
  <record id="omni_audit_event_list" model="ir.ui.view">
    <field name="name">omni_audit_event_list</field>
    <field name="model">omni.audit.event</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="create_date"/>
        <field name="actor_id"/>
        <field name="event"/>
        <field name="resource"/>
        <field name="detail"/>
        <field name="purpose_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="omni_audit_event_form" model="ir.ui.view">
    <field name="name">omni_audit_event_form</field>
    <field name="model">omni.audit.event</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <p class="text-muted">Read-only history of confirmed actions: who acted, when, and what changed. Use this to investigate setup or operational changes. Audit entries cannot be edited or deleted.</p>
          <group>
            <field name="create_date"/>
            <field name="actor_id"/>
            <field name="event"/>
            <field name="resource"/>
            <field name="detail"/>
            <field name="purpose_id"/>
            <field name="company_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_omni_audit_event" model="ir.actions.act_window">
    <field name="name">Audit</field>
    <field name="res_model">omni.audit.event</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Audit</p>
    </field>
  </record>
  <menuitem id="menu_omni_technical" name="Omnichannel" parent="base.menu_custom" groups="base.group_system" sequence="2"/>
  <menuitem id="menu_channels" name="Channels" parent="menu_omni_technical" action="action_channels" sequence="10" groups="base.group_system"/>
  <record id="command_list" model="ir.ui.view">
    <field name="name">omni.command.list</field>
    <field name="model">omni.command</field>
    <field name="arch" type="xml">
      <list decoration-warning="state == 'held'" decoration-success="state == 'approved'">
        <field name="name"/>
        <field name="channel_id"/>
        <field name="create_date"/>
        <field name="sender_id"/>
        <field name="recipient"/>
        <field name="requester_id"/>
        <field name="state" widget="label_selection"/>
        <field name="expires_at"/>
      </list>
    </field>
  </record>
  <record id="command_form" model="ir.ui.view">
    <field name="name">omni.command.form</field>
    <field name="model">omni.command</field>
    <field name="arch" type="xml">
      <form class="o_omni_clear_form">
        <header>
          <button name="action_submit" type="object" string="Submit for approval" class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_view_approval" type="object" string="Review request" invisible="not approval_request_id"/>
          <button name="action_enqueue_approved" type="object" string="Queue approved message" invisible="state != 'approved'"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'" confirm="Cancel this prepared message?"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,queued"/>
        </header>
        <sheet>
          <div class="alert alert-info" role="status">Queued means approved and waiting for the background sender. It does not mean sent or delivered.</div>
          <div class="o_omni_settings_grid mb-4">
            <div class="o_omni_setting"><label for="name" string="Name"/><field name="name" nolabel="1" readonly="state != 'draft'"/></div><div class="o_omni_setting"><label for="channel_id" string="Channel"/><field name="channel_id" nolabel="1" readonly="state != 'draft'"/></div><div class="o_omni_setting"><label for="create_date" string="Created on"/><field name="create_date" nolabel="1"/></div><div class="o_omni_setting"><label for="purpose_id" string="Team"/><field name="purpose_id" nolabel="1"/></div><div class="o_omni_setting"><label for="recipient" string="Recipient"/><field name="recipient" nolabel="1" readonly="state != 'draft'"/></div><div class="o_omni_setting"><label for="sender_id" string="Sender"/><field name="sender_id" nolabel="1"/></div><div class="o_omni_setting"><label for="requester_id" string="Requester"/><field name="requester_id" nolabel="1"/></div><div class="o_omni_setting"><label for="expires_at" string="Expires At"/><field name="expires_at" nolabel="1"/></div><div class="o_omni_setting"><label for="approval_request_id" string="Approval Request"/><field name="approval_request_id" nolabel="1" readonly="1"/></div><div class="o_omni_setting" invisible="not held_reason"><label for="held_reason" string="Why this message is held"/><field name="held_reason" nolabel="1" invisible="not held_reason"/></div></div>
          <div class="o_omni_settings_grid mb-4">
            <div class="o_omni_setting"><label for="body" string="Message content"/><field name="body" nolabel="1" readonly="state != 'draft'" placeholder="Prepare your message…"/></div><div class="o_omni_setting"><label for="reason" string="Reason"/><field name="reason" nolabel="1" readonly="state != 'draft'" placeholder="Explain why this message should be sent."/></div></div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_commands" model="ir.actions.act_window">
    <field name="name">Messages</field>
    <field name="res_model">omni.command</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Prepare a message for human review.</p>
      <p>Content and sender identity are frozen when you submit.</p>
    </field>
  </record>
  <record id="approval_omni_content" model="ir.ui.view">
    <field name="name">approval.omni.content</field>
    <field name="model">approval.center.request</field>
    <field name="inherit_id" ref="approval_center.approval_center_request_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Communication review" invisible="not omni_command_id">
          <field name="omni_command_id"/>
          <field name="omni_sender_id"/>
          <field name="omni_sender_key"/>
          <field name="omni_expires_at"/>
          <field name="omni_recipient"/>
          <field name="omni_body"/>
          <button name="action_execute" type="object" string="Queue approved message" invisible="state != 'approved'"/>
        </group>
      </xpath>
    </field>
  </record>
  <record id="sender_selection_form" model="ir.ui.view">
    <field name="name">omni.sender.selection.form</field>
    <field name="model">omni.sender.selection</field>
    <field name="arch" type="xml">
      <form string="Select runtime sender">
        <group>
          <field name="channel_id"/>
          <field name="expected_generation" invisible="1"/>
          <field name="sender_id" widget="radio" domain="[('channel_id', '=', channel_id), ('active', '=', True)]"/>
        </group>
        <p>The provider identity will be verified before switching. Failed checks preserve the current sender. Pending messages will require a fresh review after a switch.</p>
        <footer>
          <button name="action_confirm" type="object" string="Check &amp; Activate" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
