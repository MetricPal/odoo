<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="report_form" model="ir.ui.view">
    <field name="name">report.studio.report.form</field>
    <field name="model">report.studio.report</field>
    <field name="arch" type="xml">
      <form class="o_rs_form">
        <sheet>
          <div class="oe_title"><h1><field name="name" placeholder="e.g. Weekly marketing brief"/></h1>
            <field name="subtitle" placeholder="Subtitle, e.g. Week 43, all channels"/></div>
          <notebook>
            <page string="Board" name="board">
              <field name="board_data" widget="report_studio_board" nolabel="1" class="w-100"/>
            </page>
            <page string="Boxes" name="boxes">
              <field name="block_ids" nolabel="1">
                <list>
                  <field name="sequence" widget="handle"/>
                  <field name="type"/><field name="title"/><field name="width"/><field name="res_model" optional="show"/>
                </list>
              </field>
            </page>
            <page string="Settings" name="settings">
              <group class="o_rs_page_settings">
                <group string="Page">
                  <field name="paper"/><field name="orientation" widget="radio" options="{'horizontal': true}"/>
                  <field name="fit" widget="radio"/>
                </group>
                <group string="Report">
                  <field name="accent_color" widget="color"/>
                  <field name="user_id" widget="many2one_avatar_user"/><field name="shared"/>
                  <field name="company_id" groups="base.group_multi_company"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <!-- Side preview: the report as a PDF of the chosen page size (refreshed when the report changes). -->
        <div class="o_attachment_preview"/>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Box editor (opened from the board). -->
  <record id="block_form" model="ir.ui.view">
    <field name="name">report.studio.block.form</field>
    <field name="model">report.studio.block</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="type"/>
              <field name="title" placeholder="Box title (optional)"/>
              <label for="width" string="Columns"/>
              <div class="o_row"><field name="width" class="oe_inline" style="width: 4rem"/><span class="text-muted">of 4</span></div>
            </group>
            <group invisible="type not in ('kpi', 'chart', 'table', 'list')">
              <field name="model_choice" required="type in ('kpi', 'chart', 'table', 'list')"/>
              <field name="res_model" invisible="1"/>
            </group>
          </group>
          <group invisible="type not in ('kpi', 'chart', 'table', 'list') or not res_model">
            <field name="domain" string="Records" widget="domain" options="{'model': 'res_model', 'in_dialog': true}"/>
          </group>
          <group invisible="type not in ('kpi', 'chart') or not res_model">
            <group>
              <field name="measure"/>
              <field name="measure_field" widget="field_selector" options="{'model': 'res_model'}" invisible="measure == 'count'"
                     required="type in ('kpi', 'chart') and measure != 'count'" placeholder="Choose a number field"/>
            </group>
            <group invisible="type != 'kpi'">
              <field name="prefix" placeholder="e.g. RM"/><field name="suffix" placeholder="e.g. %"/>
            </group>
            <group invisible="type != 'chart'">
              <field name="chart_type"/>
              <field name="group_by" widget="field_selector" options="{'model': 'res_model'}" required="type == 'chart'"
                     placeholder="e.g. Stage, Salesperson, Date"/>
              <field name="date_interval"/>
            </group>
          </group>
          <group invisible="type not in ('table', 'list') or not res_model">
            <group>
              <field name="field_names" widget="report_studio_field_list" options="{'model': 'res_model'}" invisible="type != 'table'"/>
              <field name="list_field" widget="field_selector" options="{'model': 'res_model'}" invisible="type != 'list'"
                     placeholder="Record name"/>
            </group>
            <group>
              <field name="order" placeholder="e.g. date desc"/><field name="limit"/>
            </group>
          </group>
          <field name="content" invisible="type != 'text'" placeholder="Write here…"/>
          <group invisible="type != 'image'"><field name="image" widget="image" options="{'size': [0, 180]}"/></group>
          <group invisible="type != 'link'">
            <field name="url" placeholder="https://…" required="type == 'link'"/><field name="link_label" placeholder="Text shown"/>
          </group>
          <group invisible="type != 'view'">
            <field name="action_id" readonly="1"/><field name="view_type" readonly="1"/><field name="limit"/>
            <field name="res_model" readonly="1" string="Model"/>
            <field name="domain" string="Records" widget="domain" options="{'model': 'res_model', 'in_dialog': true}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="report_list" model="ir.ui.view">
    <field name="name">report.studio.report.list</field>
    <field name="model">report.studio.report</field>
    <field name="arch" type="xml">
      <list><field name="name"/><field name="subtitle"/><field name="paper"/><field name="orientation" optional="hide"/>
        <field name="box_count" string="Boxes"/><field name="user_id" widget="many2one_avatar_user"/>
        <field name="shared"/><field name="write_date" string="Updated"/></list>
    </field>
  </record>
  <record id="report_search" model="ir.ui.view">
    <field name="name">report.studio.report.search</field>
    <field name="model">report.studio.report</field>
    <field name="arch" type="xml">
      <search><field name="name"/><filter name="mine" string="My reports" domain="[('user_id', '=', uid)]"/>
        <filter name="shared_filter" string="Shared" domain="[('shared', '=', True)]"/></search>
    </field>
  </record>
  <record id="action_reports" model="ir.actions.act_window">
    <field name="name">Reports</field>
    <field name="res_model">report.studio.report</field>
    <field name="path">report-studio</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a report</p>
      <p>Arrange boxes (titles, text, numbers, charts, tables, lists, images, links) on a 4-column page, or use
        <i>Add to report</i> in the ⋯ menu of any list, graph or pivot. Export to PDF, Excel, PowerPoint, Word or HTML.</p></field>
  </record>
  <menuitem id="menu_reports" name="Reports" parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
            action="action_reports" sequence="5"/>
</odoo>
