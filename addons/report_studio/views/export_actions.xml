    <field name="sequence">2</field>
    <field name="state">code</field>
    <field name="code">action = records.action_export_xlsx()</field>
  </record>
  <record id="action_export_pptx" model="ir.actions.server">
    <field name="name">Export: PowerPoint</field>
    <field name="model_id" ref="model_report_studio_report"/>
    <field name="binding_model_id" ref="model_report_studio_report"/>
    <field name="binding_view_types">form</field>
    <field name="sequence">3</field>
    <field name="state">code</field>
    <field name="code">action = records.action_export_pptx()</field>
  </record>
  <record id="action_export_docx" model="ir.actions.server">
    <field name="name">Export: Word</field>
    <field name="model_id" ref="model_report_studio_report"/>
    <field name="binding_model_id" ref="model_report_studio_report"/>
    <field name="binding_view_types">form</field>
    <field name="sequence">4</field>
    <field name="state">code</field>
    <field name="code">action = records.action_export_docx()</field>
  </record>
  <record id="action_export_html" model="ir.actions.server">
    <field name="name">Export: HTML</field>
    <field name="model_id" ref="model_report_studio_report"/>
