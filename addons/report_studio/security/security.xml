<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="privilege_report_studio" model="res.groups.privilege">
    <field name="name">Report Studio</field>
    <field name="category_id" ref="base.module_category_productivity"/>
  </record>
  <record id="group_report_user" model="res.groups">
    <field name="name">User</field>
    <field name="privilege_id" ref="privilege_report_studio"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="base.group_user" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_report_user'))]"/>
  </record>
  <!-- Reports are private to their author unless shared with everyone in the company. -->
  <record id="scope_report" model="ir.access">
    <field name="name">Report Studio: own or shared reports</field>
    <field name="model_id" ref="model_report_studio_report"/>
    <field name="operation">crud</field>
    <field name="domain">[('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
  </record>
</odoo>
