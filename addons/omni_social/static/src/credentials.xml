<templates xml:space="preserve"><t t-name="omni_social.Credentials"><div t-if="this.installed" class="o_social_credentials mt-3">
<t t-if="this.ui.account_label"><label class="form-label" t-att-for="this.props.id + '_account'" t-esc="this.ui.account_label"/><input t-att-id="this.props.id + '_account'" type="text" class="form-control mb-3 o_social_account" t-att-value="this.state.account" t-on-input="(e) => { this.state.account = e.target.value; }"/></t>
<t t-if="this.oauth">
  <div t-if="this.showApp" class="o_social_app mb-3">
    <p class="text-muted mb-2">Enter the ID and secret of your developer app once. They are stored encrypted and used only for sign-in.</p>
    <label class="form-label" t-att-for="this.props.id + '_app_id'">App ID</label><input t-att-id="this.props.id + '_app_id'" type="text" class="form-control mb-2" t-att-value="this.state.appId" t-on-input="(e) => { this.state.appId = e.target.value; }"/>
    <label class="form-label" t-att-for="this.props.id + '_app_secret'">App secret</label><input t-att-id="this.props.id + '_app_secret'" type="password" autocomplete="new-password" class="form-control mb-2" t-att-value="this.state.appSecret" t-on-input="(e) => { this.state.appSecret = e.target.value; }"/>
    <button type="button" class="btn btn-secondary o_social_save_app" t-on-click="this.saveApp" t-att-disabled="this.state.busy || !this.state.appId.trim() || !this.state.appSecret.trim()">Save app</button>
    <a t-if="this.ui.developer_url" class="ms-3" t-att-href="this.ui.developer_url" target="_blank" rel="noopener noreferrer">Open developer portal</a>
  </div>
  <div t-else="" class="mb-3">
    <div t-if="!this.ui.public_url" class="alert alert-warning" role="status">Set the public HTTPS address first: the platform returns here after sign-in.</div>
    <button type="button" class="btn btn-primary o_social_sign_in" t-on-click="this.signIn" t-att-disabled="this.state.busy || !this.ui.public_url || this.accountMissing">
      <t t-if="this.props.record.data.connected">Sign in again with <t t-esc="this.ui.label"/></t><t t-else="">Sign in with <t t-esc="this.ui.label"/></t>
    </button>
    <span class="text-muted ms-3">App <t t-esc="this.ui.app_id"/> · <a href="#" t-on-click.prevent="() => { this.state.editApp = true; }">Change</a></span>
  </div>
  <a t-if="!this.state.manual" href="#" class="d-inline-block mb-3 o_social_manual" t-on-click.prevent="() => { this.state.manual = true; }">Paste an access token instead</a>
</t>
<div t-if="this.showToken" class="mb-3">
  <label class="form-label" t-att-for="this.props.id + '_token'">Access token</label><input t-att-id="this.props.id + '_token'" type="password" autocomplete="new-password" class="form-control mb-2" placeholder="Paste access token" t-att-value="this.state.token" t-on-input="(e) => { this.state.token = e.target.value; }"/>
  <div t-if="this.ui.token_hint" class="text-muted mb-2" t-esc="this.ui.token_hint"/>
  <button type="button" class="btn btn-primary o_social_connect" t-on-click="this.connect" t-att-disabled="this.state.busy || !this.state.token.trim() || this.accountMissing"><t t-if="this.state.busy">Connecting…</t><t t-else="">Connect account</t></button>
  <a t-if="this.ui.developer_url and !this.oauth" class="ms-3" t-att-href="this.ui.developer_url" target="_blank" rel="noopener noreferrer">Open developer portal</a>
</div>
<div t-if="this.webhookAllowed" class="mt-3">
<label class="form-label" t-att-for="this.props.id + '_secret'">App secret</label><input t-att-id="this.props.id + '_secret'" type="password" autocomplete="new-password" class="form-control mb-3" placeholder="For signed webhooks" t-att-value="this.state.secret" t-on-input="(e) => { this.state.secret = e.target.value; }"/>
<button type="button" class="btn btn-secondary" t-on-click="this.webhook" t-att-disabled="this.state.busy || !this.state.secret.trim()">Configure webhooks</button>
<div class="text-muted mt-2">Register the callback in your app’s developer portal.</div>
</div></div></t></templates>
