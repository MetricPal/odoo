<templates xml:space="preserve"><t t-name="omni_social.Credentials"><div t-if="this.installed" class="mt-3">
<label class="form-label" t-att-for="this.props.id + '_token'">Access token</label><input t-att-id="this.props.id + '_token'" type="password" autocomplete="new-password" class="form-control mb-3" placeholder="Paste access token" t-att-value="this.state.token" t-on-input="(e) => { this.state.token = e.target.value; }"/>
<t t-if="this.linkedInPage"><label class="form-label" t-att-for="this.props.id + '_page'">LinkedIn Page ID</label><input t-att-id="this.props.id + '_page'" type="text" class="form-control mb-3" placeholder="Numeric Page ID" t-att-value="this.state.account" t-on-input="(e) => { this.state.account = e.target.value; }"/></t>
<button type="button" class="btn btn-primary" t-on-click="this.connect" t-att-disabled="this.state.busy || !this.state.token.trim()"><t t-if="this.state.busy">Connecting…</t><t t-else="">Connect account</t></button>
<a t-if="this.props.record.data.provider === 'instagram'" class="ms-3" href="https://developers.facebook.com/apps/" target="_blank" rel="noopener noreferrer">Create Meta app</a>
<a t-else="" class="ms-3" href="https://www.linkedin.com/developers/apps" target="_blank" rel="noopener noreferrer">Create LinkedIn app</a>
<div t-if="this.props.record.data.connected &amp;&amp; !(this.props.record.data.provider === 'linkedin' &amp;&amp; this.props.record.data.account_kind === 'person')" class="mt-3">
<label class="form-label" t-att-for="this.props.id + '_secret'">App secret</label><input t-att-id="this.props.id + '_secret'" type="password" autocomplete="new-password" class="form-control mb-3" placeholder="For signed webhooks" t-att-value="this.state.secret" t-on-input="(e) => { this.state.secret = e.target.value; }"/>
<button type="button" class="btn btn-secondary" t-on-click="this.webhook" t-att-disabled="this.state.busy || !this.state.secret.trim()">Configure webhooks</button>
<div class="text-muted mt-2">Register the callback in your app’s developer portal.</div>
</div></div></t></templates>
