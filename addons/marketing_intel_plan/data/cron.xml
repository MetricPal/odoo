<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Reads results back from the apps (clicks, sends, leads, sales, registrations); changes nothing in them. -->
  <record id="cron_refresh_results" model="ir.cron">
    <field name="name">Marketing Intelligence: refresh campaign status and results</field>
    <field name="model_id" ref="model_mi_plan"/>
    <field name="state">code</field>
    <field name="code">model._cron_refresh_results()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>
  <!-- Creates the next run of repeating campaigns a few days before they start (as their owner). -->
  <record id="cron_repeat" model="ir.cron">
    <field name="name">Marketing: create the next run of repeating campaigns</field>
    <field name="model_id" ref="model_mi_plan"/>
    <field name="state">code</field>
    <field name="code">model._cron_repeat()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>
  <!-- Due results reviews (monthly / quarterly / six-monthly): refresh numbers, give the owner a To-Do. -->
  <record id="cron_reviews" model="ir.cron">
    <field name="name">Marketing: campaign result reviews</field>
    <field name="model_id" ref="model_mi_plan"/>
    <field name="state">code</field>
    <field name="code">model._cron_reviews()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
  </record>
</odoo>
