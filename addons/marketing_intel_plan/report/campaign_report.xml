<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_campaign" model="ir.actions.report">
    <field name="name">Campaign report (PDF)</field>
    <field name="model">mi.plan</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">marketing_intel_plan.report_campaign</field>
    <field name="print_report_name">'Campaign - %s' % object.name</field>
    <field name="binding_model_id" ref="model_mi_plan"/>
    <field name="binding_type">report</field>
  </record>
  <template id="report_campaign">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="plan">
        <t t-call="web.external_layout">
          <div class="page">
            <h2 t-out="plan.name"/>
            <p class="text-muted">
              <t t-out="plan.brand_id.name"/> · <t t-out="plan.user_id.name"/> ·
              <span t-field="plan.date_start"/> → <span t-field="plan.date_end"/> ·
              <t t-out="plan.phase_label"/>
            </p>
            <table class="table table-sm o_main_table">
              <tbody>
                <tr><th>Budget</th><td><span t-field="plan.budget"/></td><th>Spent</th><td><span t-field="plan.spent"/></td></tr>
                <tr><th>Target quarter</th><td><span t-field="plan.target_quarter"/></td><th>Channels</th><td t-out="plan.channel_label"/></tr>
                <tr><th>Goal</th><td t-out="plan.goal_id.name or '-'"/><th>Proposal</th><td><span t-field="plan.proposal_type"/> · <t t-out="plan.snapshot_id.name or '-'"/></td></tr>
              </tbody>
            </table>
            <div t-if="plan.takeaway" class="p-2 mb-3" style="background-color: #1f2d2b; color: #fff;">
              <b>Takeaway.</b> <span style="white-space: pre-line" t-out="plan.takeaway"/></div>
            <h4>Message and audience</h4>
            <p style="white-space: pre-line" t-out="plan.message or '-'"/>
            <p style="white-space: pre-line" class="text-muted" t-out="plan.audience or ''"/>
            <h4>Channels and results</h4>
            <table class="table table-sm o_main_table">
              <thead><tr><th>Channel</th><th>Status</th><th class="text-end">Sent</th><th class="text-end">Opened</th>
                <th class="text-end">Clicks</th><th class="text-end">Registrations</th></tr></thead>
              <tbody>
                <tr t-foreach="plan.item_ids" t-as="item">
                  <td><span t-field="item.channel"/></td><td><span t-field="item.stage"/></td>
                  <td class="text-end" t-out="item.result_sent"/><td class="text-end" t-out="item.result_opened"/>
                  <td class="text-end" t-out="item.result_clicks"/><td class="text-end" t-out="item.result_registrations"/>
                </tr>
              </tbody>
            </table>
            <h4>Business results</h4>
            <p>Leads: <t t-out="plan.result_leads"/> · Won deals: <t t-out="plan.result_won"/> ·
              Revenue: <span t-field="plan.result_revenue"/></p>
            <p>Revenue / spend: <t t-out="'%.2f×' % (plan.result_revenue / plan.spent) if plan.spent else '-'"/> ·
              Cost per lead: <t t-out="'%.0f' % (plan.spent / plan.result_leads) if plan.spent and plan.result_leads else '-'"/></p>
            <t t-if="plan.objectives_met or plan.what_worked or plan.to_improve or plan.next_steps">
              <h4>Evaluation</h4>
              <table class="table table-sm">
                <tr t-if="plan.objectives_met"><th>Objectives met?</th><td><span t-field="plan.objectives_met"/></td></tr>
                <tr t-if="plan.effective"><th>Was it effective?</th><td style="white-space: pre-line" t-out="plan.effective"/></tr>
                <tr t-if="plan.what_worked"><th>What worked</th><td style="white-space: pre-line" t-out="plan.what_worked"/></tr>
                <tr t-if="plan.to_improve"><th>What to improve</th><td style="white-space: pre-line" t-out="plan.to_improve"/></tr>
                <tr t-if="plan.next_steps"><th>What to do next</th><td style="white-space: pre-line" t-out="plan.next_steps"/></tr>
                <tr t-if="plan.lost_reasons"><th>Top loss reasons</th><td t-out="plan.lost_reasons"/></tr>
                <tr t-if="plan.objections"><th>Objections heard</th><td style="white-space: pre-line" t-out="plan.objections"/></tr>
                <tr t-if="plan.buyer_language"><th>Words buyers use</th><td style="white-space: pre-line" t-out="plan.buyer_language"/></tr>
              </table>
            </t>
            <t t-if="plan.advice_ids"><h4>Recommendations</h4>
              <ul><li t-foreach="plan.advice_ids" t-as="advice"><t t-out="advice.name"/><t t-if="advice.target"> (<t t-out="advice.target"/>)</t></li></ul></t>
            <t t-if="plan.learning_note"><h4>What we learned</h4><p style="white-space: pre-line" t-out="plan.learning_note"/></t>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
