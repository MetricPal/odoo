<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="plan_form" model="ir.ui.view">
    <field name="name">mi.plan.form</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><form duplicate="0">
      <header>
        <button name="action_submit_proposal" type="object" string="Submit for approval" class="btn-primary"
                invisible="is_template or phase != 'research' or proposal_state not in ('draft', 'changes') or state == 'cancelled'"
                help="Sends the proposal through the approvals of its type, as To-Do activities for each approver."/>
        <button name="action_approve_proposal" type="object" string="Approve" class="btn-success"
                invisible="not can_decide"/>
        <button name="action_decide_proposal" type="object" string="Request changes" context="{'decision': 'changes'}"
                invisible="not can_request_changes"/>
        <button name="action_decide_proposal" type="object" string="Refuse" context="{'decision': 'refuse'}"
                invisible="not can_decide"/>
        <button name="action_split_by_brand" type="object" string="Split by brand"
                invisible="is_template or proposal_state != 'approved' or not other_brand_ids"
                help="One campaign per brand, each linked to this approved research."/>
        <button name="action_print_report" type="object" string="Print report"
                invisible="is_template or phase not in ('results', 'evaluation')"/>
        <button name="action_start_evaluation" type="object" string="Start evaluation" class="btn-primary"
                invisible="is_template or phase != 'results'"/>
        <button name="action_mark_evaluated" type="object" string="Mark done" class="btn-primary"
                invisible="is_template or phase != 'evaluation' or evaluation_done"/>
        <button name="action_prepare" type="object" string="Prepare drafts" class="btn-primary"
                invisible="is_template or state not in ('brief', 'content') or worker != 'me' or phase not in ('research', 'planning')"
                help="Creates a draft in each app (Social, Messaging, Email, SMS, Events) for you to write."/>
        <button name="action_submit_review" type="object" string="Send for review" class="btn-primary"
                invisible="is_template or state not in ('brief', 'content') or phase != 'planning'"
                help="One review for the whole campaign. Nothing goes out before it is approved."/>
        <button name="action_approve_review" type="object" string="Approve campaign" class="btn-success"
                invisible="is_template or not can_review" help="Approves every part of this campaign that waits for you."/>
        <button name="action_refuse_review" type="object" string="Refuse" invisible="is_template or not can_review"/>
        <button name="action_refresh_results" type="object" string="Refresh"
                invisible="is_template or state == 'cancelled' or phase not in ('execution', 'results')"/>
        <button name="action_execute_now" type="object" string="Execute now" class="btn-primary"
                invisible="is_template or state not in ('scheduled', 'live')"
                confirm="Send every approved and scheduled channel now?"/>
        <button name="action_done" type="object" string="Mark done" invisible="is_template or state not in ('scheduled', 'live')"/>
        <button name="action_reset" type="object" string="Start again" invisible="is_template or state != 'cancelled'"/>
        <button name="action_use_template" type="object" string="Use this template" class="btn-primary"
                invisible="not is_template"/>
        <field name="is_template" invisible="1"/>
        <field name="state" invisible="1"/><field name="can_review" invisible="1"/>
        <field name="status" invisible="1"/>
        <field name="can_decide" invisible="1"/><field name="can_request_changes" invisible="1"/>
        <field name="proposal_state" invisible="1"/><field name="evaluation_done" invisible="1"/>
        <field name="phase" widget="statusbar" invisible="is_template"/>
      </header>
      <sheet>
        <field name="needs_me" invisible="1"/>
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="status"
             invisible="not needs_me or state in ('done', 'cancelled')">
          <span class="fw-bold">Your next step:</span> <field name="my_todo_html" nolabel="1" readonly="1" class="o_mi_inline_html"/>
        </div>
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="status"
             invisible="needs_me or not next_step or state in ('done', 'cancelled')">
          <span class="fw-bold">Next step:</span> <field name="next_step_html" nolabel="1" readonly="1" class="o_mi_inline_html"/>
        </div>
        <div class="alert alert-warning" role="status" invisible="not clash_note"><field name="clash_note" nolabel="1"/></div>
        <div class="oe_button_box" name="button_box">
          <button name="action_open_channels" type="object" class="oe_stat_button" icon="payments" invisible="is_template"
                  help="Budget, and what was spent so far (Spend in Execution).">
            <div class="o_stat_info"><span class="o_stat_value"><field name="budget" widget="monetary" nolabel="1"/></span>
              <span class="o_stat_text"><field name="budget_label" nolabel="1"/></span></div>
          </button>
          <button name="action_open_channels" type="object" class="oe_stat_button" icon="calendar_today" invisible="is_template">
            <div class="o_stat_info"><span class="o_stat_value"><field name="duration_days" nolabel="1"/> days</span>
              <span class="o_stat_text"><field name="timeline_label" nolabel="1"/></span></div>
          </button>
          <button name="action_open_channels" type="object" class="oe_stat_button" icon="campaign">
            <div class="o_stat_info"><span class="o_stat_value"><field name="channel_count" nolabel="1"/> channels</span>
              <span class="o_stat_text text-truncate" style="max-width: 160px;"><field name="channel_label" nolabel="1"/></span></div>
          </button>
          <field name="saved_template_id" invisible="1"/>
        </div>
        <span class="badge text-bg-primary mb-2" invisible="not is_template">Template</span>
        <div class="oe_title"><label for="name" string="Campaign"/><h1><field name="name" placeholder="e.g. Clinic owners webinar"/></h1>
          <field name="phase_label" widget="badge" invisible="is_template"
                 decoration-warning="phase == 'research' and proposal_state in ('approval', 'changes')"
                 decoration-info="phase in ('research', 'planning') and proposal_state not in ('approval', 'changes')"
                 decoration-success="phase in ('execution', 'results', 'evaluation')" decoration-muted="state == 'cancelled'"/>
          <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small" name="links" invisible="is_template">
            <button name="action_open_spend" type="object" class="btn btn-link p-0 small">
              <field name="spend_link" nolabel="1" class="d-inline"/> →
            </button>
          </div>
          <div class="small text-muted mt-1" invisible="not snapshot_id">
            Approved proposal: <field name="snapshot_id" nolabel="1" readonly="1" options="{'no_open': True}" class="d-inline"/> ·
            <button name="action_view_snapshot" type="object" class="btn btn-link p-0 small">View approved version</button>
          </div></div>
        <div class="d-flex flex-wrap align-items-center gap-4 mb-3" invisible="is_template or state == 'brief'">
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted">Channels sent</span>
            <div style="min-width: 180px;"><field name="channels_out" widget="progressbar" options="{'max_value': 'channel_count'}"/></div>
            <field name="channel_count" invisible="1"/>
          </div>
          <span class="text-muted"><field name="day_label"/></span>
        </div>
        <group>
          <group>
            <field name="user_id" widget="many2one_avatar_user"/>
            <field name="brand_id" readonly="state not in ('brief', 'content')"/>
            <field name="other_brand_ids" widget="many2many_tags" invisible="is_template"
                   readonly="phase != 'research' and not other_brand_ids"/>
            <field name="split_from_id" invisible="not split_from_id"/>
            <label for="proposal_type" invisible="is_template"/>
            <div class="d-flex flex-column" invisible="is_template">
              <field name="proposal_type" widget="radio" options="{'horizontal': true}"
                     readonly="phase != 'research' or proposal_state not in ('draft', 'changes')"/>
              <span class="small text-muted" invisible="not approval_route">Approvals: <field name="approval_route" nolabel="1" class="d-inline"/></span>
            </div>
            <field name="template_id" invisible="not template_id"/>
            <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"
                   invisible="not is_template"/>
            <field name="worker" widget="radio" options="{'horizontal': true}" readonly="state not in ('brief', 'content')"/>
          </group>
          <group><label for="date_start" string="Dates" invisible="is_template"/>
            <div class="o_row" invisible="is_template"><field name="date_start"/> → <field name="date_end"/></div>
            <field name="target_quarter" invisible="is_template"/>
            <field name="budget"/><field name="currency_id" invisible="1"/>
            <field name="repeat"/>
            <field name="repeat_until" invisible="repeat == 'none'"/>
            <field name="next_run_date" invisible="not next_run_date"/>
            <field name="series_id" invisible="not series_id"/>
            <field name="template_source_id" invisible="not template_source_id"/>
            <field name="utm_campaign_id" invisible="not utm_campaign_id" groups="base.group_no_one"/></group>
        </group>
        <notebook>
          <page string="Overview" name="message">
            <widget name="mi_campaign_overview" invisible="is_template"/>
            <separator string="Channels" invisible="is_template"/>
            <field name="item_ids" readonly="1" invisible="is_template">
              <list create="0" delete="0">
                <field name="channel"/><field name="pillar"/>
                <field name="stage" widget="badge" decoration-success="stage in ('out', 'todo_done')"
                       decoration-info="stage in ('scheduled', 'approved')" decoration-warning="stage in ('needs_review', 'writing')"
                       decoration-danger="stage in ('failed', 'blocked')" decoration-muted="stage in ('not_started', 'unavailable', 'draft')"/>
                <field name="schedule_at"/>
              </list>
            </field>
            <group>
              <group string="Message &amp; audience"><field name="message"/><field name="audience"/></group>
              <group string="Goal &amp; KPIs"><field name="goal_id" options="{'no_create': True}"/><field name="kpis"/></group>
            </group>
          </page>
          <page string="Saved texts" name="template_texts" invisible="not is_template">
            <field name="item_ids">
              <list editable="bottom" create="0">
                <field name="channel" readonly="1" width="140px"/>
                <field name="content_subject" string="Subject / title"/>
                <field name="content_text" string="Text" class="o_mi_wrap"/>
              </list>
            </field>
            <div class="text-muted small">Each new campaign from this template starts with these texts in its drafts.</div>
          </page>
          <page string="Market Research" name="research" invisible="is_template">
            <field name="research_locked" invisible="1"/>
            <div class="alert alert-info mb-3" role="status" invisible="not research_locked">
              The proposal is in approval: the research is locked until it is approved or changes are requested.
            </div>
            <div class="text-muted mb-2" invisible="not recommendation_id">
              Started from the suggested campaign <field name="recommendation_id" readonly="1" class="d-inline"/>.
            </div>
            <div name="research_agent"/>
            <group invisible="not recommendation_id">
              <field name="research_problem"/>
              <field name="research_expected"/>
              <field name="research_risks"/>
            </group>
            <group>
              <field name="research_summary" placeholder="What the research found, in a few sentences." readonly="research_locked"/>
            </group>
            <group>
              <group string="Upstream">
                <field name="upstream_ids" nolabel="1" colspan="2" readonly="research_locked">
                  <list editable="bottom"><field name="sequence" widget="handle"/><field name="partner_id"/>
                    <field name="role"/><field name="side" column_invisible="1"/></list>
                </field>
              </group>
              <group string="Downstream">
                <field name="downstream_ids" nolabel="1" colspan="2" readonly="research_locked">
                  <list editable="bottom"><field name="sequence" widget="handle"/><field name="partner_id"/>
                    <field name="role"/><field name="side" column_invisible="1"/></list>
                </field>
              </group>
            </group>
            <group>
              <group string="Target audience">
                <field name="audience_company" readonly="research_locked"/>
                <field name="audience_people" readonly="research_locked"/>
                <field name="audience_demographics" readonly="research_locked"/>
                <field name="country_ids" widget="many2many_tags" readonly="research_locked"/>
                <field name="state_ids" widget="many2many_tags" readonly="research_locked" invisible="not country_ids"/>
                <field name="places" readonly="research_locked" placeholder="e.g. Penang island, KL Sentral"/>
              </group>
              <group string="Action plan &amp; milestones">
                <field name="action_plan" nolabel="1" colspan="2" readonly="research_locked"
                       placeholder="The proposed actions and how they will be carried out."/>
                <field name="milestone_ids" nolabel="1" colspan="2" readonly="research_locked">
                  <list editable="bottom"><field name="name"/><field name="date"/><field name="done" widget="boolean_toggle"/></list>
                </field>
              </group>
            </group>
            <separator string="Evidence"/>
            <field name="evidence_ids" readonly="research_locked">
              <list editable="bottom">
                <field name="source_type" widget="badge"/><field name="finding" class="o_mi_wrap"/>
                <field name="date"/><field name="url" widget="url"/><field name="by_ai" optional="hide"/>
              </list>
            </field>
            <field name="research_findings" invisible="not recommendation_id" readonly="1">
              <list><field name="display_name" string="Evidence from the suggestion"/></list>
            </field>
          </page>
          <page string="Execution" name="channels" invisible="is_template">
            <separator string="Design"/>
            <separator string="Channels"/>
            <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"
                   placeholder="Add a channel" readonly="state not in ('brief', 'content')"/>
            <field name="item_ids">
              <list editable="bottom" create="0">
                <field name="channel" readonly="1"/>
                <field name="pillar"/>
                <field name="available" column_invisible="1"/>
                <field name="stage" widget="badge" width="170px" decoration-success="stage in ('out', 'todo_done')"
                       decoration-info="stage in ('scheduled', 'approved')" decoration-warning="stage in ('needs_review', 'writing')"
                       decoration-danger="stage in ('failed', 'blocked')" decoration-muted="stage in ('not_started', 'unavailable', 'draft')"/>
                <field name="schedule_at" readonly="stage in ('out', 'todo_done') or channel in ('event_virtual', 'event_physical')"/>
                <field name="activity_done" widget="boolean_toggle" width="70px" invisible="channel not in ('content', 'ads', 'partnership')"/>
                <field name="next_step" class="o_mi_wrap" optional="hide"/>
                <field name="app" optional="hide"/>
                <field name="draft_status" string="In its app" optional="hide"/>
                <field name="note" column_invisible="1"/><field name="res_id" column_invisible="1"/>
                <button name="action_open" type="object" string="Open" icon="arrow_forward" invisible="not res_id"/>
              </list>
            </field>
            <div class="text-muted small">Statuses: <b>Being written</b> → <b>Waiting for approval</b> → <b>Scheduled</b>
              → <b>Sent</b>. <b>Needs fixing</b> and <b>Failed</b> say what to do in Next step. One review covers the
              campaign: Email, SMS and Events go out only after it; Messaging and Social keep their own approval,
              decided from this screen. Every change is written in the history.</div>
          </page>
          <page string="Results" name="results" invisible="is_template">
            <div class="o_mi_takeaway_box d-flex gap-3 align-items-start mb-3">
              <span class="small fw-bold text-uppercase pt-1" style="color: #9fd3b5; min-width: 90px;">Takeaway</span>
              <field name="takeaway" nolabel="1" class="flex-grow-1"
                     placeholder="What the results mean and what to do about them, in one paragraph for management."/>
            </div>
            <widget name="mi_campaign_results"/>
            <group><field name="compare_plan_id" options="{'no_create': True}"/></group>
            <separator string="Channel activity detail"/>
            <field name="item_ids" readonly="1">
              <list create="0" delete="0">
                <field name="channel"/>
                <field name="result_audience" invisible="not res_id"/>
                <field name="result_sent" invisible="channel not in ('email', 'sms', 'messaging', 'social')"/>
                <field name="result_delivered" optional="show" invisible="channel not in ('email', 'sms', 'messaging')"/>
                <field name="result_opened" invisible="channel != 'email'"/>
                <field name="result_clicks" invisible="channel not in ('email', 'sms', 'messaging')"/>
                <field name="result_replied" invisible="channel != 'email'"/>
                <field name="result_likes" optional="show" invisible="channel != 'social'"/>
                <field name="result_comments" optional="show" invisible="channel != 'social'"/>
                <field name="result_registrations" optional="show" invisible="channel not in ('event_virtual', 'event_physical')"/>
                <field name="result_attended" optional="hide" invisible="channel not in ('event_virtual', 'event_physical')"/>
                <field name="result_failed" invisible="channel not in ('email', 'sms', 'messaging', 'social')"/>
                <field name="res_id" column_invisible="1"/>
              </list>
            </field>
            <group>
              <group string="Campaign totals">
                <field name="result_sent"/><field name="result_opened"/><field name="result_clicks"/>
                <field name="result_replied"/><field name="result_registrations"/>
              </group>
              <group string="Business results">
                <field name="result_leads"/><field name="result_won"/><field name="result_revenue"/>
                <field name="cost_per_lead"/><field name="return_on_budget" widget="percentage"/>
                <field name="results_at"/>
              </group>
            </group>
            <field name="kpi_ids">
              <list editable="bottom">
                <field name="metric"/><field name="target"/><field name="actual"/>
                <field name="progress" widget="progressbar"/>
              </list>
            </field>
            <div class="text-muted small mt-2">Each channel's numbers come from its app: Email and SMS (audience, sent,
              delivered, opened, clicked, replies, bounced), Messaging (recipients, sent, clicks, not sent), Social
              (posts, published, likes, comments), Events (seats, registrations, attended). Leads, won deals and revenue
              come from CRM and Sales records tagged with the campaign. Updated every hour and on Refresh.</div>
          </page>
          <page string="Evaluation" name="evaluation" invisible="is_template or phase not in ('results', 'evaluation')">
            <group string="Assessment">
              <field name="objectives_met" widget="radio" options="{'horizontal': true}"/>
              <field name="effective"/>
              <field name="what_worked"/>
              <field name="to_improve"/>
              <field name="next_steps"/>
            </group>
            <group>
              <group string="Wins &amp; losses">
                <field name="win_loss_label"/>
                <field name="lost_reasons"/>
              </group>
              <group string="Objections &amp; buyer language">
                <field name="objections"/>
                <field name="buyer_language"/>
              </group>
            </group>
            <separator string="Recommendations"/>
            <field name="advice_ids">
              <list editable="bottom">
                <field name="sequence" widget="handle"/><field name="name"/><field name="target"/>
                <field name="state" widget="badge" decoration-success="state == 'accepted'" decoration-muted="state == 'rejected'"/>
              </list>
            </field>
            <group>
              <group string="Review schedule">
                <field name="review_monthly"/><field name="review_quarterly"/><field name="review_halfyear"/>
                <field name="next_review_date" invisible="not next_review_date"/>
              </group>
              <group string="What we learned">
                <field name="learning_note" nolabel="1" colspan="2"
                       placeholder="What worked, what did not, what to try next. The next AI analysis reads this."/>
              </group>
            </group>
            <div class="text-muted small">Each review refreshes the numbers from CRM and Sales and gives the owner a To-Do
              to update objections and win/loss.</div>
          </page>
        </notebook>
      </sheet>
      <chatter/>
    </form></field>
  </record>
  <record id="plan_list" model="ir.ui.view">
    <field name="name">mi.plan.list</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><list js_class="mi_campaign_list" sample="1">
      <field name="name"/>
      <field name="repeat" optional="hide" string="Repeats" widget="badge" invisible="repeat == 'none'"/>
      <field name="brand_id"/>
      <field name="phase" column_invisible="1"/><field name="proposal_state" column_invisible="1"/><field name="state" column_invisible="1"/>
      <field name="phase_label" string="Stage" widget="badge"
             decoration-warning="phase == 'research' and proposal_state in ('approval', 'changes')"
             decoration-info="phase in ('research', 'planning') and proposal_state not in ('approval', 'changes')"
             decoration-success="phase in ('execution', 'results', 'evaluation')" decoration-muted="state == 'cancelled'"/>
      <field name="proposal_type" optional="hide"/>
      <field name="user_id" widget="many2one_avatar_user"/>
      <field name="budget" sum="Total"/><field name="currency_id" column_invisible="1"/>
      <field name="target_quarter" optional="show"/>
      <field name="date_start" optional="hide"/>
      <field name="date_end" string="Ends"/>
      <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
      <field name="channels_out" widget="progressbar" options="{'max_value': 'channel_count'}" string="Channels sent" optional="hide"/>
      <field name="channel_count" column_invisible="1"/>
      <field name="result_leads" sum="Total" optional="hide"/><field name="result_revenue" sum="Total" optional="hide"/>
      <field name="next_step" optional="hide" class="o_mi_wrap"/>
      <field name="goal_id" optional="hide"/>
      <field name="activity_ids" widget="list_activity" optional="show"/>
    </list></field>
  </record>
  <record id="plan_kanban" model="ir.ui.view">
    <field name="name">mi.plan.kanban</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><kanban default_group_by="phase" group_create="0" group_delete="0" group_edit="0"
                                          records_draggable="0" quick_create="0">
      <field name="needs_me"/><field name="worker"/>
      <templates><t t-name="card">
        <div class="d-flex justify-content-between">
          <field name="name" class="fw-bold"/>
          <span class="badge text-bg-warning" invisible="not needs_me">Your action needed</span>
        </div>
        <div class="text-muted small d-flex flex-wrap gap-1"><field name="brand_id"/><span>·</span>
          <field name="date_start" widget="date"/><span>→</span><field name="date_end" widget="date"/></div>
        <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        <div class="d-flex align-items-center gap-2 mt-1"><span class="small text-muted">Sent</span>
          <field name="channels_out" widget="progressbar" options="{'max_value': 'channel_count'}"/></div>
        <field name="channel_count" invisible="1"/>
        <div class="small mt-1" t-att-class="record.needs_me.raw_value ? 'text-warning-emphasis fw-bold' : 'text-muted'">
          <field name="next_step"/></div>
        <footer class="pt-1">
          <span class="small text-muted" invisible="worker != 'ai'">✨ AI assistant</span>
          <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
        </footer>
      </t></templates>
    </kanban></field>
  </record>
  <record id="plan_calendar" model="ir.ui.view">
    <field name="name">mi.plan.calendar</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><calendar date_start="date_start" date_stop="date_end" color="color" mode="month" quick_create="0" all_day="date_start">
      <field name="name"/><field name="brand_id"/><field name="phase_label"/>
    </calendar></field>
  </record>
  <record id="plan_pivot" model="ir.ui.view">
    <field name="name">mi.plan.pivot</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><pivot string="Campaign results">
      <field name="brand_id" type="row"/><field name="phase" type="col"/>
      <field name="budget" type="measure"/><field name="result_leads" type="measure"/>
      <field name="result_won" type="measure"/><field name="result_revenue" type="measure"/>
    </pivot></field>
  </record>
  <record id="plan_search" model="ir.ui.view">
    <field name="name">mi.plan.search</field><field name="model">mi.plan</field>
    <field name="arch" type="xml"><search>
      <field name="name"/><field name="brand_id"/>
      <filter name="needs_me" string="Your action needed" domain="[('needs_me', '=', True)]"/>
      <filter name="active_plans" string="Active" domain="[('state', '!=', 'cancelled'), ('evaluation_done', '=', False)]"/>
      <filter name="mine" string="My campaigns" domain="[('user_id', '=', uid)]"/>
      <filter name="my_activities" string="My activities" domain="[('activity_user_id', '=', uid)]"/>
      <separator/>
      <filter name="stage_research" string="Market Research" domain="[('phase', '=', 'research'), ('state', '!=', 'cancelled')]"/>
      <filter name="stage_planning" string="Planning" domain="[('phase', '=', 'planning'), ('state', '!=', 'cancelled')]"/>
      <filter name="stage_execution" string="Execution" domain="[('phase', '=', 'execution'), ('state', '!=', 'cancelled')]"/>
      <filter name="stage_results" string="Results" domain="[('phase', '=', 'results'), ('state', '!=', 'cancelled')]"/>
      <filter name="stage_evaluation" string="Evaluation" domain="[('phase', '=', 'evaluation'), ('state', '!=', 'cancelled')]"/>
      <separator/>
      <filter name="paid" string="Paid" domain="[('proposal_type', '=', 'paid')]"/>
      <filter name="owned" string="Owned" domain="[('proposal_type', '=', 'owned')]"/>
      <filter name="earned" string="Earned" domain="[('proposal_type', '=', 'earned')]"/>
      <filter name="by_ai" string="Run by the AI assistant" domain="[('worker', '=', 'ai')]"/>
      <separator/>
      <filter name="last_quarter" string="Last quarter" domain="[('quarter_when', '=', 'last')]"/>
      <filter name="this_quarter" string="This quarter" domain="[('quarter_when', '=', 'this')]"/>
      <filter name="next_quarter" string="Next quarter" domain="[('quarter_when', '=', 'next')]"/>
      <field name="target_quarter"/>
      <group><filter name="group_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
        <filter name="group_state" string="Stage" context="{'group_by': 'phase'}"/>
        <filter name="group_type" string="Proposal type" context="{'group_by': 'proposal_type'}"/>
        <filter name="group_quarter" string="Target quarter" context="{'group_by': 'target_quarter'}"/></group>
    </search></field>
  </record>
  <record id="action_plans" model="ir.actions.act_window">
    <field name="name">Campaigns</field><field name="res_model">mi.plan</field>
    <field name="view_mode">kanban,list,calendar,pivot,form</field><field name="context">{'search_default_active_plans': 1}</field>
    <field name="domain">[('is_template', '=', False)]</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No campaign yet</p>
      <p>Create one yourself (brand, goal, channels, dates, budget), or start from a suggested campaign with
        <i>Use this idea</i>. Drafts are then prepared in Social, Messaging, Email, SMS and Events.</p></field>
  </record>
  <record id="action_campaign_results" model="ir.actions.act_window">
    <field name="name">Campaign results</field><field name="res_model">mi.plan</field>
    <field name="view_mode">pivot,list,form</field>
  </record>
  <record id="goal_report_list" model="ir.ui.view">
    <field name="name">mi.goal.report.list</field><field name="model">mi.goal</field>
    <field name="arch" type="xml"><list create="0">
      <field name="brand_id"/><field name="name"/><field name="measure"/><field name="target"/><field name="achieved"/>
      <field name="progress" widget="progressbar"/><field name="date_start"/><field name="date_end"/>
    </list></field>
  </record>
  <record id="action_goals" model="ir.actions.act_window">
    <field name="name">Goals</field><field name="res_model">mi.goal</field><field name="view_mode">list</field>
    <field name="view_id" ref="goal_report_list"/><field name="context">{'group_by': 'brand_id'}</field>
  </record>
  <record id="action_control_panel" model="ir.actions.client">
    <field name="name">Marketing</field><field name="tag">marketing_intel_plan.control_panel</field>
    <field name="path">marketing-panel</field>
  </record>
  <record id="marketing_intel.menu_root" model="ir.ui.menu">
    <field name="action" ref="action_control_panel"/>
  </record>
  <menuitem id="menu_control_panel" name="Control panel" parent="marketing_intel.menu_root" action="action_control_panel" sequence="1"/>
  <record id="server_action_duplicate" model="ir.actions.server">
    <field name="name">Duplicate &amp; edit</field>
    <field name="model_id" ref="model_mi_plan"/><field name="binding_model_id" ref="model_mi_plan"/>
    <field name="binding_view_types">form</field><field name="state">code</field>
    <field name="code">action = records.action_duplicate()</field>
  </record>
  <record id="server_action_cancel" model="ir.actions.server">
    <field name="name">Cancel campaign</field>
    <field name="model_id" ref="model_mi_plan"/><field name="binding_model_id" ref="model_mi_plan"/>
    <field name="binding_view_types">form</field><field name="state">code</field>
    <field name="code">records.action_cancel()</field>
  </record>
  <record id="server_action_save_template" model="ir.actions.server">
    <field name="name">Save as template</field>
    <field name="model_id" ref="model_mi_plan"/><field name="binding_model_id" ref="model_mi_plan"/>
    <field name="binding_view_types">form</field><field name="state">code</field>
    <field name="code">action = records.action_save_template()</field>
  </record>
  <record id="plan_template_list" model="ir.ui.view">
    <field name="name">mi.plan.template.list</field><field name="model">mi.plan</field><field name="priority">30</field>
    <field name="arch" type="xml"><list>
      <field name="name" string="Template"/><field name="brand_id"/>
      <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
      <field name="repeat" string="Repeats" widget="badge" invisible="repeat == 'none'" optional="show"/>
      <field name="budget" optional="show"/><field name="currency_id" column_invisible="1"/>
      <field name="template_source_id" optional="show"/>
      <field name="template_use_count" optional="show"/>
      <field name="user_id" widget="many2one_avatar_user" optional="show"/>
      <field name="write_date" string="Last updated" optional="show"/>
    </list></field>
  </record>
  <record id="action_templates" model="ir.actions.act_window">
    <field name="name">Campaign templates</field><field name="res_model">mi.plan</field>
    <field name="view_mode">list,form</field><field name="domain">[('is_template', '=', True)]</field>
    <field name="view_id" ref="plan_template_list"/>
    <field name="context">{'default_is_template': True}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No template yet</p>
      <p>Open any campaign and click <b>Save as template</b>; then <b>Use this template</b> starts a new campaign
        with the same channels and texts.</p></field>
  </record>
  <menuitem id="menu_campaigns_root" name="Campaigns" parent="marketing_intel.menu_root" sequence="10"/>
  <menuitem id="menu_plans" name="All campaigns" parent="menu_campaigns_root" action="action_plans" sequence="10"/>
  <menuitem id="menu_templates" name="Templates" parent="menu_campaigns_root" action="action_templates" sequence="20"/>
  <record id="action_portfolio" model="ir.actions.client">
    <field name="name">Portfolio</field><field name="tag">marketing_intel_plan.portfolio</field>
    <field name="path">marketing-portfolio</field>
  </record>
  <menuitem id="menu_goals" name="Goals" parent="menu_campaigns_root" action="action_goals" sequence="30"/>

  <record id="recommendation_form_plan" model="ir.ui.view">
    <field name="name">mi.recommendation.form.plan</field><field name="model">mi.recommendation</field>
    <field name="inherit_id" ref="marketing_intel.recommendation_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_choose']" position="before">
        <button name="action_use_idea" type="object" string="Use this idea" class="btn-primary"
                invisible="state == 'rejected' or plan_count"
                help="Starts a campaign from this suggestion, pre-filled with its channels, budget, dates and message."/>
      </xpath>
      <xpath expr="//div[hasclass('oe_title')]" position="before">
        <div class="oe_button_box" name="button_box">
          <button name="action_open_plans" type="object" class="oe_stat_button" icon="calendar_today" invisible="not plan_count">
            <field name="plan_count" widget="statinfo" string="Campaigns"/>
          </button>
        </div>
      </xpath>
    </field>
  </record>
  <record id="brand_form_campaigns" model="ir.ui.view">
    <field name="name">mi.brand.form.campaigns</field><field name="model">mi.brand</field>
    <field name="inherit_id" ref="marketing_intel.brand_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_run_research']" position="before">
        <button name="action_new_campaign" type="object" string="New campaign" class="btn-primary"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_campaigns" type="object" class="oe_stat_button" icon="campaign">
          <field name="campaign_count" widget="statinfo" string="Campaigns"/>
        </button>
      </xpath>
      <xpath expr="//page[@name='overview']" position="after">
        <page string="Campaigns" name="campaigns">
          <field name="plan_ids" context="{'default_brand_id': id}">
            <list create="0">
              <field name="name"/><field name="goal_id"/><field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              <field name="date_start"/><field name="date_end"/><field name="budget"/><field name="currency_id" column_invisible="1"/>
              <field name="result_leads" optional="show"/><field name="result_revenue" optional="show"/>
              <field name="channels_out" widget="progressbar" options="{'max_value': 'channel_count'}" string="Channels sent"/>
              <field name="channel_count" column_invisible="1"/>
              <field name="next_step" class="o_mi_wrap"/>
              <field name="phase_label" string="Stage" widget="badge"/>
            </list>
          </field>
        </page>
      </xpath>
      <xpath expr="//field[@name='goal_ids']/list/field[@name='current']" position="replace">
        <field name="measure"/>
        <field name="current" string="Value (by hand)" readonly="measure != 'manual'" optional="hide"/>
        <field name="achieved"/>
      </xpath>
    </field>
  </record>
  <record id="brand_kanban_campaigns" model="ir.ui.view">
    <field name="name">mi.brand.kanban.campaigns</field><field name="model">mi.brand</field>
    <field name="inherit_id" ref="marketing_intel.brand_kanban"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='stats']" position="inside">
        <a name="action_open_campaigns" type="object" class="text-reset">
          <span class="fw-bold fs-5"><field name="active_campaign_count"/></span> <span class="text-muted small">active campaigns</span></a>
      </xpath>
      <xpath expr="//kanban" position="inside"><field name="monthly_budget"/></xpath>
      <xpath expr="//div[@name='next']" position="before">
        <div class="d-flex flex-wrap gap-2 mb-1" name="attention">
          <a name="action_open_needs_me" type="object" class="badge text-bg-danger text-decoration-none"
             invisible="not needs_me_count"><field name="needs_me_count"/> to-do(s) for you</a>
          <span class="badge text-bg-warning" invisible="not goals_behind_count">
            <field name="goals_behind_count"/> goal(s) behind schedule</span>
          <span class="badge" invisible="not monthly_budget"
                t-att-class="record.budget_month_pct.raw_value &gt; 100 ? 'text-bg-danger' : 'text-bg-light'">
            Budget this month: <field name="budget_month_pct"/>%</span>
        </div>
      </xpath>
      <xpath expr="//footer[@name='buttons']" position="inside">
        <button name="action_new_campaign" type="object" class="btn btn-sm btn-primary">New campaign</button>
      </xpath>
    </field>
  </record>
</odoo>
