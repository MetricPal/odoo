<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shipped defaults: loaded once, then owned by the admin (upgrades never reset them). -->
    <data noupdate="1">
    <record id="approval_type_business_trip" model="approval.center.policy">
        <field name="name">Business Trip</field>
        <field name="description">Approve travel requests before employees make arrangements.</field>
        <field name="sequence">10</field>
        <field name="image_128" type="bytes" file="approval_center/static/img/approval_type_business_trip.svg"/>
        <field name="has_document">optional</field>
        <field name="has_period">required</field>
        <field name="has_location">required</field>
        <field name="manager_approval">1</field>
        <field name="approval_minimum">1</field>
    </record>

