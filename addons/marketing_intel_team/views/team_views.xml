<odoo>
  <!-- Team and roles (approved board 5.1, ADR 0016). -->
  <record id="team_form" model="ir.ui.view">
    <field name="name">mi.team.form</field>
    <field name="model">mi.team</field>
    <field name="arch" type="xml">
      <form string="Team and roles">
        <sheet>
          <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="department_id" placeholder="Marketing"/>
              <field name="hod_label" string="Head of department"/>
              <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </group>
          </group>
          <div class="row">
            <div class="col-lg-7">
              <separator string="Marketing team"/>
              <field name="member_ids" nolabel="1">
                <list editable="bottom">
                  <field name="user_id"/>
                  <field name="role" widget="badge" decoration-primary="role == 'hod'" decoration-info="role == 'senior'"/>
                  <field name="senior_id" string="Reports to" options="{'no_create': True}"/>
                  <field name="reviews_label"/>
                  <field name="is_assistant" column_invisible="True"/>
                </list>
              </field>
              <div class="text-muted small">Role = Marketing access right (Junior ⊂ Senior ⊂ Head of department). "Reports to" is who reviews the person's work; it starts from their manager in Employees. AI assistant users' access rights stay with administrators.</div>
            </div>
            <div class="col-lg-5">
              <separator string="What a senior may release alone"/>
              <p class="text-muted small">Above any limit the release goes to the head of department. 0 means no limit.</p>
              <group>
                <field name="currency_id" invisible="1"/>
                <field name="senior_budget_limit"/>
                <field name="senior_audience_limit"/>
                <field name="senior_channel_ids" widget="many2many_checkboxes"/>
              </group>
              <div class="text-muted small mb-3">Paid proposals keep their own approvals (head of department, Finance, CEO).</div>
              <separator string="Approvers"/>
              <field name="approver_ids" nolabel="1" readonly="1">
                <list create="0" delete="0"><field name="role"/><field name="user_id"/></list>
              </field>
              <button name="action_set_approvers" type="object" string="Set approvers" class="btn-link p-0"/>
            </div>
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_team" model="ir.actions.server">
    <field name="name">Team and roles</field>
    <field name="model_id" ref="model_mi_team"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_team()</field>
  </record>
  <menuitem id="menu_team" name="Team and roles" parent="marketing_intel.menu_setup" action="action_team"
            groups="marketing_intel.group_mi_user" sequence="1"/>
</odoo>
