<odoo>
  <!-- The marketing department is the team (ADR 0016); no Marketing tab (owner, 2026-11-09). The dashboard's links
       open the department form. -->
  <record id="action_mi_department" model="ir.actions.server">
    <field name="name">Marketing department</field>
    <field name="model_id" ref="hr.model_hr_department"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_mi_department()</field>
  </record>
</odoo>
