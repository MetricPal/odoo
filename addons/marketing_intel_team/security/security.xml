<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Marketing roles (ADR 0016): Junior ⊂ Senior ⊂ Head of department ⊂ Administrator. The former "User" is Junior. -->
  <record id="marketing_intel.group_mi_user" model="res.groups">
    <field name="name">Junior</field>
    <field name="sequence">10</field>
  </record>
  <record id="group_mi_senior" model="res.groups">
    <field name="name">Senior</field>
    <field name="privilege_id" ref="marketing_intel.privilege_mi"/>
    <field name="implied_ids" eval="[(4, ref('marketing_intel.group_mi_user'))]"/>
    <field name="sequence">20</field>
  </record>
  <record id="group_mi_hod" model="res.groups">
    <field name="name">Head of department</field>
    <field name="privilege_id" ref="marketing_intel.privilege_mi"/>
    <field name="implied_ids" eval="[(4, ref('group_mi_senior'))]"/>
    <field name="sequence">30</field>
  </record>
  <record id="marketing_intel.group_mi_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_mi_hod'))]"/>
    <field name="sequence">40</field>
  </record>
</odoo>
