<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Starts approved mailings at their scheduled time. It only queues messages; the
       Omnichannel dispatch worker sends them when sending is enabled on the channel. -->
  <record id="cron_send_scheduled" model="ir.cron">
    <field name="name">Messaging Marketing: start scheduled mailings</field>
    <field name="model_id" ref="model_mm_mailing"/>
    <field name="state">code</field>
    <field name="code">model._cron_send_scheduled()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>
</odoo>
