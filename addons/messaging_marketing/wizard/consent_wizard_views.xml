<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="consent_wizard_form" model="ir.ui.view">
    <field name="name">mm.consent.wizard.form</field>
    <field name="model">mm.consent.wizard</field>
    <field name="arch" type="xml">
      <form>
        <div class="alert alert-info" role="status">
          Marketing messages are sent only to people who agreed to receive them. Record what the person said,
          how, and the proof, so you can show it if asked. Records are kept and cannot be edited.
        </div>
        <group>
          <field name="contact_ids" widget="many2many_tags"/>
          <field name="channel" widget="radio" options="{'horizontal': true}"/>
          <field name="action" widget="radio"/>
          <field name="source" widget="radio" options="{'horizontal': true}"/>
          <field name="evidence" required="action == 'opt_in'"
                 placeholder="e.g. Newsletter checkbox on the website sign-up form, 3 Oct 2026, order S00042"/>
        </group>
        <footer>
          <button name="action_record" type="object" string="Record" class="btn-primary"/>
          <button special="cancel" string="Cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="contact_import_form" model="ir.ui.view">
    <field name="name">mm.contact.import.form</field>
    <field name="model">mm.contact.import</field>
    <field name="arch" type="xml">
      <form>
        <div class="alert alert-warning" role="status">
          Adding people here does not opt them in. Each person still needs a recorded opt-in before they receive
          marketing messages.
        </div>
        <group>
          <field name="partner_ids" widget="many2many_tags" options="{'no_create': true}"/>
          <field name="list_id" options="{'no_create': true}"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Add" class="btn-primary"/>
          <button special="cancel" string="Cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_contact_import" model="ir.actions.act_window">
    <field name="name">Add from Contacts</field>
    <field name="res_model">mm.contact.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
