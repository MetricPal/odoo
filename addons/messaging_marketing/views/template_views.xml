<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- WhatsApp templates (plan M8, board 15.1): standard list and form. -->
  <record id="template_list" model="ir.ui.view">
    <field name="name">mm.whatsapp.template.list</field>
    <field name="model">mm.whatsapp.template</field>
    <field name="arch" type="xml">
      <list>
        <header>
          <button name="action_update_from_meta" type="object" string="Update from Meta" display="always"/>
        </header>
        <field name="name"/>
        <field name="language"/>
        <field name="channel_id"/>
        <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state in ('review', 'paused')"
               decoration-danger="state == 'rejected'"/>
        <field name="meta_reason" optional="hide"/>
        <field name="submitted_at" optional="hide"/>
        <field name="checked_at" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="template_form" model="ir.ui.view">
    <field name="name">mm.whatsapp.template.form</field>
    <field name="model">mm.whatsapp.template</field>
    <field name="arch" type="xml">
      <form class="o_mm_mailing o_mm_template">
        <header>
          <button name="action_submit" type="object" string="Submit to Meta" class="btn-primary" invisible="state != 'draft'"
                  confirm="Meta reviews the text. This usually takes minutes, sometimes a day. The text cannot be changed while it is in review, or after."/>
          <button name="action_copy_language" type="object" string="Copy to another language"/>
          <button name="action_new_draft" type="object" string="Edit as a new draft" invisible="state == 'draft'"/>
          <button name="action_update_from_meta" type="object" string="Update from Meta" invisible="state == 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
        </header>
        <div class="alert alert-danger mb-0" role="alert" invisible="state != 'rejected'">
          <strong>Rejected by Meta.</strong>
          <span invisible="not meta_reason"> Meta's reason: <field name="meta_reason" nolabel="1" class="d-inline"/>.</span>
          Change the text in a new draft and submit it again.
        </div>
        <div class="alert alert-warning mb-0" role="alert" invisible="state != 'paused'">
          <strong>Paused by Meta:</strong> too many people blocked or reported it. Mailings that use it wait until Meta lifts the pause, and say so.
        </div>
        <div class="alert alert-warning mb-0" role="alert" invisible="state != 'review'">
          <strong>In review at Meta</strong> since <field name="submitted_at" nolabel="1" class="d-inline"/>. You get a notification when Meta answers.
        </div>
        <div class="alert alert-warning mb-0" role="alert" invisible="state != 'draft' or not meta_reason">
          <field name="meta_reason" nolabel="1" class="d-inline"/>
        </div>
        <sheet>
          <field name="uses_first_name" invisible="1"/><field name="uses_name" invisible="1"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="e.g. Spring offer" readonly="state != 'draft'"/></h1>
          </div>
          <div class="row g-4">
            <div class="col-lg-7">
              <group>
                <field name="channel_id" readonly="state != 'draft'" options="{'no_create': true, 'no_open': true}"/>
                <field name="language" readonly="state != 'draft'"/>
                <field name="kind"/>
              </group>
              <div><label for="header" class="o_mm_label"/></div>
              <div class="mb-3"><field name="header" nolabel="1" class="w-100" readonly="state != 'draft'" placeholder="Optional: one short line in bold"/></div>
              <div><label for="body" string="Message" class="o_mm_label"/></div>
              <field name="body" nolabel="1" readonly="state != 'draft'" class="o_mm_body"
                     placeholder="Hi {first_name}, our Ramadan offer starts today: 20% off everything until Sunday."/>
              <div class="d-flex justify-content-between small text-muted mb-3">
                <span invisible="state != 'draft'">Personalise with <code>{first_name}</code> or <code>{name}</code>. The message cannot start or end with a field.</span>
                <span invisible="state == 'draft'">The text cannot be changed after it was submitted.</span>
                <span class="text-nowrap ms-2"><field name="char_count" class="d-inline" nolabel="1"/> / 1,024</span>
              </div>
              <div><label for="footer" class="o_mm_label"/></div>
              <div class="mb-3"><field name="footer" nolabel="1" class="w-100" readonly="state != 'draft'" placeholder="Optional: Reply STOP to stop these messages"/></div>
              <group>
                <field name="button_label" readonly="state != 'draft'" placeholder="Optional: Shop now"/>
                <field name="button_url" readonly="state != 'draft'" placeholder="https://" invisible="not button_label and not button_url"/>
                <field name="example_first_name" readonly="state != 'draft'" invisible="not uses_first_name" required="uses_first_name"/>
                <field name="example_name" readonly="state != 'draft'" invisible="not uses_name" required="uses_name"/>
              </group>
              <group string="At Meta" invisible="state == 'draft'">
                <field name="meta_name"/>
                <field name="submitted_at"/>
                <field name="checked_at"/>
              </group>
            </div>
            <div class="col-lg-5">
              <div class="o_mm_phone o_mm_phone_whatsapp">
                <div class="o_mm_phone_bar">
                  <span class="o_mm_phone_avatar"><i class="oi" data-icon="campaign" title="Message"/></span>
                  <span class="o_mm_phone_title"><field name="channel_id" nolabel="1" readonly="1" options="{'no_open': true}" placeholder="Your number"/></span>
                </div>
                <div class="o_mm_phone_screen">
                  <div class="o_mm_bubble" invisible="not preview_text"><div class="fw-bold" invisible="not header"><field name="header" nolabel="1" readonly="1"/></div><field name="preview_text" nolabel="1" readonly="1"/><div class="small text-muted" invisible="not footer"><field name="footer" nolabel="1" readonly="1"/></div><div class="o_mm_bubble_button" invisible="not button_label"><field name="button_label" nolabel="1" readonly="1"/></div></div>

                  <div class="o_mm_phone_empty" invisible="preview_text">Your message appears here as recipients will see it.</div>
                </div>
              </div>
              <div class="text-muted small text-center mt-2" invisible="not preview_text">Approximate: WhatsApp shows the final layout.</div>
            </div>
          </div>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="template_search" model="ir.ui.view">
    <field name="name">mm.whatsapp.template.search</field>
    <field name="model">mm.whatsapp.template</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="channel_id"/>
        <filter name="approved" string="Approved by Meta" domain="[('state', '=', 'approved')]"/>
        <filter name="waiting" string="Waiting" domain="[('state', 'in', ('draft', 'review'))]"/>
        <filter name="attention" string="Needs attention" domain="[('state', 'in', ('rejected', 'paused'))]"/>
        <group>
          <filter name="group_channel" string="Send from" context="{'group_by': 'channel_id'}"/>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
          <filter name="group_language" string="Language" context="{'group_by': 'language'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_templates" model="ir.actions.act_window">
    <field name="name">WhatsApp templates</field>
    <field name="res_model">mm.whatsapp.template</field>
    <field name="view_mode">list,form</field>
    <field name="path">whatsapp-templates</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Write your first WhatsApp template</p>
      <p>WhatsApp only lets a business start a conversation with a text Meta has approved. Write the text here,
        submit it to Meta, and use it in a mailing once it is approved.</p>
    </field>
  </record>
</odoo>
