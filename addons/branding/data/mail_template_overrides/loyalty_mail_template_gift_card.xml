<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_loyalty_mail_template_gift_card" model="branding.mail.template.override">
            <field name="xmlid">loyalty.mail_template_gift_card</field>
            <field name="template_name">Gift Card: Gift Card Information</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div style="padding: 10px; background-color: white;" class="o-mail-template-body">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;">
                    <tr>
                        <td align="center">
                            <table role="presentation" cellpadding="0" cellspacing="0" width="300" style="width:85%;max-width:300px;background-color:#f8f9fa;">
                                <tr>
                                    <td align="center" valign="middle">
                                       <img src="/loyalty/static/img/gift_card.png" style="display:block; border:0; outline:none; text-decoration:none; margin:auto;" width="250"/>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <div style="margin:20px 0 10px; font-size:22px; font-family:arial, 'helvetica neue', helvetica, sans-serif; line-height:36px; color:#333333; text-align: center">
                    Here is your gift card!
                    <h3 style="margin:0px 0px 20px; line-height:48px; font-family:arial, 'helvetica neue', helvetica, sans-serif; font-size:36px; font-style:normal; font-weight:normal; color:#333333; text-align:center">
                        <strong t-out="format_amount(object.points, object.currency_id) or ''">$ 150.00</strong>
                    </h3>
                </div>
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;">
                    <tr>
                        <td align="center">
                            <table role="presentation" cellpadding="0" cellspacing="0" width="300" style="width:85%;max-width:300px;background-color:white;border: 2px dashed #9A9CA5;">
                                <tr>
                                    <td align="center" valign="middle" style="padding:20px;background-color:white;font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
                                        <p style="margin:0px; font-size:22px;font-family:arial, 'helvetica neue', helvetica, sans-serif; line-height:38px; color:#333333">
                                            <strong t-out="object.code or ''">4f10-15d6-41b7-b04c-7b3e</strong>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
                <div t-if="object.expiration_date" style="padding:0; margin:10px 0 0; text-align:center;">
                    <h3 style="margin:0px; line-height:17px; font-family:arial, 'helvetica neue', helvetica, sans-serif; font-size:14px; font-style:normal; font-weight:normal; color:#555555; text-align:center">Valid until <t t-out="format_date(object.expiration_date) or ''">05/05/2021</t></h3>
                </div>
                <div style="padding:0; margin-top:20px;padding-bottom:10px;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;">
                        <tr>
                            <td align="center">
                                <table border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td align="center" style="border-radius: 5px; background-color: #999999;">
                                            <a t-attf-href="{{ object.get_base_url() }}/shop" target="_blank" t-attf-style="text-decoration:none; font-family:arial, 'helvetica neue', helvetica, sans-serif; font-size:18px; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border: 1px solid {{object.company_id.email_secondary_color or '#875A7B'}}; padding:12px 18px; display:inline-block; background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; border-radius:5px; font-style:normal; line-height:26px; width:auto; text-align:center">Redeem Now!</a>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        
            </field>
        </record>
  </data>
</odoo>
