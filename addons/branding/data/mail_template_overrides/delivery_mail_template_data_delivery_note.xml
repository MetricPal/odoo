<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_delivery_mail_template_data_delivery_note" model="branding.mail.template.override">
            <field name="xmlid">delivery.mail_template_data_delivery_note</field>
            <field name="template_name">Shipping: Send by Email</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,<br/><br/>
        We are glad to inform you that your order has been shipped.
        <t t-if="object.tracking_ref">
            Your tracking reference is
            <strong>
                <t t-if="object.tracking_url">
                    <a t-attf-href="{{ object.tracking_url }}" target="_blank" t-out="object.tracking_ref"/>.
                </t>
                <t t-else="">
                    <t t-out="object.tracking_ref"/>.
                </t>
            </strong>
        </t>
        <br/><br/>
        Please find your delivery order attached for more details.<br/><br/>
        Thank you,
        <t t-if="user.signature">
            <br/>
            <div>--<br/><t t-out="user.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            
            </field>
        </record>
  </data>
</odoo>
