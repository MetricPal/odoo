<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_gamification_email_template_goal_reminder" model="branding.mail.template.override">
            <field name="xmlid">gamification.email_template_goal_reminder</field>
            <field name="template_name">Gamification: Reminder For Goal Update</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div>
    <strong>Reminder</strong><br/>
    You have not updated your progress for the goal <t t-out="object.definition_id.name or ''"/> (currently reached at <t t-out="object.completeness or ''"/>%) for at least <t t-out="object.remind_update_delay or ''"/> days. Do not forget to do it.
    <br/><br/>
    Thank you,
    <t t-if="object.challenge_id.manager_id.signature">
        <br/>
        <t t-out="object.challenge_id.manager_id.signature or ''"/>
    </t>
</div>
            </field>
        </record>
  </data>
</odoo>
