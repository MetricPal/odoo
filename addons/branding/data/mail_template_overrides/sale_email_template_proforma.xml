<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_sale_email_template_proforma" model="branding.mail.template.override">
            <field name="xmlid">sale.email_template_proforma</field>
            <field name="template_name">Sales: Send Pro Forma</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        <t t-if="object.state in ('draft', 'sent')">
            Your Pro forma invoice for quotation <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        </t>
        <t t-else="">
            Your Pro forma invoice for order <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        </t>
        <t t-if="object.origin">
            (with reference: <t t-out="object.origin or ''"/> )
        </t>
        <t t-if="object.client_order_ref">
            (<t t-out="object.client_order_ref or ''">CUSTOMER REF</t>)
        </t>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span> is available.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            
            </field>
        </record>
  </data>
</odoo>
