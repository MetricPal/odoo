<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_mail_group_mail_template_guidelines" model="branding.mail.template.override">
            <field name="xmlid">mail_group.mail_template_guidelines</field>
            <field name="template_name">Mail Group: Send Guidelines</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div>
                <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
                <p>Please find below the guidelines of the <t t-out="object.mail_group_id.name"/> mailing list.</p>
                <p><t t-out="object.mail_group_id.moderation_guidelines_msg or ''"/></p>
            </div>
        
            </field>
        </record>
  </data>
</odoo>
