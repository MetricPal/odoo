<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_l10n_ar_stock_email_template_ar_remitos_delivery_guide" model="branding.mail.template.override">
            <field name="xmlid">l10n_ar_stock.email_template_ar_remitos_delivery_guide</field>
            <field name="template_name">Delivery guide: Send by email</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear
        <t t-if="object.partner_id.parent_id">
            <t t-out="object.partner_id.name or ''">Brandon Freeman</t> (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>),
        </t>
        <t t-else="">
            <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        </t>
        <br/><br/>
        Here is your
        <t t-if="object.l10n_ar_delivery_guide_number">
            document <strong t-out="object.l10n_ar_delivery_guide_number or ''">00001-00000001</strong>
        </t>
        <t t-else="">
            document
        </t>
        <t t-if="object.origin">
            (with reference: <t t-out="object.origin or ''">SUB003</t>)
        </t>
        from <t t-out="object.company_id.name or ''">YourCompany</t>.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
    </p>
</div>
            
            </field>
        </record>
  </data>
</odoo>
