<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="template_override_sale_email_template_edi_sale" model="branding.mail.template.override">
            <field name="xmlid">sale.email_template_edi_sale</field>
            <field name="template_name">Sales: Send Quotation</field>
            <field name="email_layout_xmlid">branding.branding_mail_layout</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        <t t-if="object.state in ('draft', 'sent')">
            Your quotation <span style="font-weight: bold;" t-out="object.name or ''"/>
            <t t-if="object.origin">
                (with reference: <t t-out="object.origin or ''">S00052</t> )
            </t>
            <t t-if="object.client_order_ref">
                (<t t-out="object.client_order_ref or ''">CUSTOMER REF</t>)
            </t>
            amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span> is ready for review.
        </t>
        <t t-else="">
            Your order <span style="font-weight: bold;" t-out="object.name or ''"/>
            <t t-if="object.origin">
                (with reference: <t t-out="object.origin or ''">S00052</t> )
            </t>
            <t t-if="object.client_order_ref">
                (<t t-out="object.client_order_ref or ''">CUSTOMER REF</t>)
            </t>
            amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span> is ready for review.
        </t>
        <br/>
        <t t-set="documents" t-value="object._get_product_documents()"/>
        <t t-if="documents">
            <br/>
            <t t-if="len(documents)&gt;1">
                Here are some additional documents that may interest you:
            </t>
            <t t-else="">
                Here is an additional document that may interest you:
            </t>
            <ul style="margin-bottom: 0;">
                <t t-foreach="documents" t-as="document">
                    <li style="font-size: 13px;">
                        <a t-out="document.ir_attachment_id.name" t-att-href="object.get_portal_url('/document/' + str(document.id))" t-att-target="target"/>
                    </li>
                </t>
            </ul>
        </t>
        <br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            
            </field>
        </record>
  </data>
</odoo>
