<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_email_branding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.email.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mail_templates_setting']/div[field[@name='email_secondary_color']]" position="after">
                <div class="w-50 row mt-1">
                    <span class="d-block w-75 py-2">Body Background</span>
                    <field name="email_body_background_color" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
                <div class="w-50 row mt-1">
                    <span class="d-block w-75 py-2">Content Background</span>
                    <field name="email_content_background_color" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
                <div class="w-50 row mt-1">
                    <span class="d-block w-75 py-2">Footer Background</span>
                    <field name="email_footer_background_color" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
