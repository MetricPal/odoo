<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="digest_mail_powered_by_remove" inherit_id="digest.digest_mail_main" name="Remove Digest Odoo Brand Promotion" priority="99">
        <xpath expr="(//table)[1]" position="attributes">
            <attribute name="data-branding-email-kind">digest</attribute>
        </xpath>
        <xpath expr="//table[@id='header']" position="attributes">
            <attribute name="width">656</attribute>
            <attribute name="style">width:656px; max-width:656px; border-top:1px solid #eeeeee; border-left:1px solid #eeeeee; border-right:1px solid #eeeeee; border-radius: 12px 12px 0 0; border-collapse: separate; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//table[@id='header']//td[hasclass('p0')][1]" position="attributes">
            <attribute name="style">padding: 24px 28px 5px 28px;</attribute>
        </xpath>
        <xpath expr="//table[@id='header']//td[@align='right'][hasclass('p0')]" position="attributes">
            <attribute name="style">padding: 24px 28px 5px 0px;</attribute>
        </xpath>
        <xpath expr="//table[@id='header']//td[@colspan='4']" position="attributes">
            <attribute name="style">padding-left: 28px; padding-right: 28px;</attribute>
        </xpath>
        <xpath expr="//table[hasclass('global_layout') and not(@id='header')]" position="attributes">
            <attribute name="width">656</attribute>
            <attribute name="style">width:656px; max-width:656px; border-left:1px solid #eeeeee; border-right:1px solid #eeeeee; border-bottom:1px solid #eeeeee; border-radius: 0 0 12px 12px; border-collapse: separate; overflow: hidden;</attribute>
        </xpath>
        <xpath expr="//tr[@t-if='tips']/td" position="attributes">
            <attribute name="style">width: 100%; padding: 24px 28px; border: 1px solid #F9FAFB;</attribute>
        </xpath>
        <xpath expr="//td[hasclass('global_td')]" position="attributes">
            <attribute name="style">padding: 24px 28px 0px 28px;</attribute>
        </xpath>
        <xpath expr="//tfoot//td[@style='padding: 20px; border-bottom: 1px solid #d8dadd;']" position="attributes">
            <attribute name="style">padding: 24px 28px; border-bottom: 1px solid #eeeeee;</attribute>
        </xpath>
        <xpath expr="//p[@id='powered']" position="replace"/>
        <xpath expr="//p[hasclass('company_name')]" position="replace"/>
        <xpath expr="//div[hasclass('by_odoo')]" position="attributes">
            <attribute name="style">display:none; max-height:0; overflow:hidden; font-size:0; line-height:0;</attribute>
        </xpath>
        <xpath expr="//tr[@t-if='display_mobile_banner']" position="replace"/>
        <xpath expr="//tfoot/tr[td//div[@id='footer']]" position="replace">
            <tr>
                <td height="32" style="height:32px; line-height:32px; font-size:0;">&amp;nbsp;</td>
            </tr>
            <tr>
                <td align="center" style="padding:0 0 32px 0; text-align:center;">
                    <t t-set="branding_unsubscribe_url" t-value="'/digest/%s/unsubscribe?token=%s&amp;user_id=%s' % (object.id, unsubscribe_token, user.id) if unsubscribe_token else False"/>
                    <t t-call="branding.branding_mail_footer"/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
