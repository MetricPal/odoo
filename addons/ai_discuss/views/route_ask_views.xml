<odoo>
  <record id="route_ask_form" model="ir.ui.view">
    <field name="name">ai.agent.route.ask.form</field>
    <field name="model">ai.agent.route.ask</field>
    <field name="arch" type="xml">
      <form string="Ask an assistant">
        <field name="router_run_id" invisible="1"/>
        <field name="allowed_agent_ids" invisible="1"/>
        <p class="text-muted" invisible="router_run_id">Your question goes to the right assistant among yours. It answers in your chat with it, with what you may see.</p>
        <field name="prompt" nolabel="1" placeholder="Ask a question…" readonly="router_run_id"/>
        <group invisible="not router_run_id">
          <field name="agent_id" required="router_run_id" domain="[('id', 'in', allowed_agent_ids)]"
                 options="{'no_create': True, 'no_open': True}" placeholder="Choose another assistant"/>
        </group>
        <footer>
          <button name="action_send" type="object" string="Send" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_route_ask" model="ir.actions.act_window">
    <field name="name">Ask an assistant</field>
    <field name="res_model">ai.agent.route.ask</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <record id="action_route_change" model="ir.actions.act_window">
    <field name="name">Ask another assistant</field>
    <field name="res_model">ai.agent.route.ask</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
