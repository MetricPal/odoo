<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <!-- Runs approved marketing workflows on events that happened since the last check. -->
  <record id="cron_run_flows" model="ir.cron">
    <field name="name">Marketing: run approved workflows</field>
    <field name="model_id" ref="model_mi_flow"/>
    <field name="state">code</field>
    <field name="code">model._cron_run()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
  </record>
</odoo>
