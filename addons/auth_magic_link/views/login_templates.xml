<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keep the core web login structure independent from Website's global
         extension of web.login_layout. -->
    <template id="standalone_login_layout" name="Standalone Web Login Layout">
        <t t-set="head">
            <t t-out="head"/>
        </t>
        <t t-call="web.frontend_layout"
           html_data="{'style': 'height: 100%;'}"
           body_classname.f="bg-100"
           no_header="True"
           no_footer="True"
           head="head">
            <div class="container py-5">
                <div t-attf-class="card border-0 mx-auto bg-transparent {{login_card_classes}} o_database_list"
                     style="max-width: 300px;">
                    <div class="card-body bg-transparent">
                        <div class="text-center pb-3 border-bottom mb-4"
                             t-if="not res_company.uses_default_logo">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                 alt="Logo"
                                 style="max-height:120px; max-width: 100%; width:auto"/>
                        </div>
                        <t t-out="0"/>
                        <div class="text-center small mt-4 pt-3 border-top"
                             t-if="not disable_footer">
                            <t t-if="not disable_database_manager">
                                <a class="border-end pe-2 me-1"
                                   href="/web/database/manager">Manage Databases</a>
                            </t>
                            <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth"
                               target="_blank">Powered by <span>Odoo</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Website replaces the shared authentication layout globally. Restore
         the standalone wrapper for reset, signup, TOTP, and other auth pages. -->
    <template id="standalone_auth_pages"
              inherit_id="website.login_layout"
              priority="99"
              name="Standalone Authentication Pages">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="auth_magic_link.standalone_login_layout">
                <t t-out="0"/>
            </t>
        </xpath>
    </template>

    <template id="web_login_magic_link" inherit_id="web.login" name="Configurable authentication login">
        <xpath expr="//t[@t-call='web.login_layout']" position="attributes">
            <attribute name="t-call">auth_magic_link.standalone_login_layout</attribute>
        </xpath>

        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
            <attribute name="t-attf-class" add="o_auth_password_field" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
            <attribute name="t-attf-class" add="o_auth_password_field" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="after">
            <div t-if="auth_email_login_mode in ('magic_link', 'both')"
                 t-attf-class="mt-3 mb-1 o_auth_magic_link_field {{ 'd-none' if auth_email_login_mode == 'both' and not auth_magic_link_magic_view else '' }}">
                <label for="email_login" class="form-label d-flex justify-content-between w-100">Email</label>
                <input type="email"
                       name="email_login"
                       id="email_login"
                       t-att-value="login or ''"
                       class="form-control"
                       placeholder="Enter your email"
                       autocomplete="email"
                       autocapitalize="off"
                       t-att-disabled="'disabled' if auth_email_login_mode == 'both' and not auth_magic_link_magic_view else None"
                       required="required"/>
            </div>
        </xpath>

        <!-- Scope Odoo's native alerts to the authentication view that produced them. -->
        <xpath expr="//p[@role='alert']" position="attributes">
            <attribute name="t-attf-class" add="o_auth_form_alert {{ 'o_auth_magic_alert' if auth_email_alert_view == 'magic' else 'o_auth_password_alert' }}" separator=" "/>
        </xpath>
        <xpath expr="//p[@role='status']" position="attributes">
            <attribute name="t-attf-class" add="o_auth_form_alert {{ 'o_auth_magic_alert' if auth_email_alert_view == 'magic' else 'o_auth_password_alert' }}" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit'][1]" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit'][1]" position="after">
            <button t-if="auth_email_login_mode in ('magic_link', 'both')"
                    type="submit"
                    name="type"
                    value="magic_link"
                    t-attf-class="btn btn-primary mt-2 o_auth_email_submit {{ 'd-none' if auth_email_login_mode == 'both' and not auth_magic_link_magic_view else '' }}">
                Send login link
            </button>

            <!-- One toggle stays below the active submit button in both views. -->
            <button t-if="auth_email_login_mode == 'both'"
                    type="button"
                    class="btn btn-link w-100 mt-1 p-0 o_auth_method_toggle"
                    t-att-data-auth-view="'magic' if auth_magic_link_magic_view else 'password'">
                <t t-if="auth_magic_link_magic_view">Sign in with password</t>
                <t t-else="">Sign in using magic link</t>
            </button>

            <!-- Magic-link view gets its own chooser trigger. JS delegates to Odoo's native UserSwitch. -->
            <button t-if="auth_email_login_mode == 'both'"
                    type="button"
                    class="btn btn-link btn-sm mt-2 o_auth_magic_choose_user d-none">
                Choose a user
            </button>
        </xpath>

        <xpath expr="//input[@name='type' and @value='password']" position="attributes">
            <attribute name="t-if">auth_email_login_mode in ('password', 'both')</attribute>
            <attribute name="class">o_auth_password_type</attribute>
        </xpath>
    </template>

    <template id="magic_login_confirm" name="Confirm magic link sign-in">
        <t t-call="auth_magic_link.standalone_login_layout">
            <div class="o_auth_magic_confirm text-center">
                <h4 class="mb-2">Continue to sign in</h4>
                <p class="text-muted">Signing in as <strong t-out="magic_user_name"/>.</p>
                <form method="post" action="/auth/magic-login" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" t-att-value="token"/>
                    <input type="hidden" name="redirect" t-att-value="redirect" t-if="redirect"/>
                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </form>
                <a href="/web/login" class="btn btn-link btn-sm mt-2">Not you? Back to sign in</a>
            </div>
        </t>
    </template>
</odoo>
