<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_email_login_v4" model="mail.template">
            <field name="name">Email Login Link</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Sign in to {{ object.company_id.name or 'Odoo' }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to" eval="False"/>
            <field name="email_to">{{ object.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0"
                       style="padding-top:16px; background-color:#FFFFFF; font-family:Verdana, Arial,sans-serif; color:#454748; width:100%; border-collapse:separate;">
                    <tr>
                        <td align="left">
                            <table border="0" cellpadding="0" cellspacing="0" width="590" align="left"
                                   style="padding:16px; background-color:#FFFFFF; color:#454748; border-collapse:separate;">
                                <tbody>
                                    <!-- HEADER -->
                                    <tr>
                                        <td align="left" style="min-width:590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590"
                                                   style="min-width:590px; background-color:white; padding:0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="middle">
                                                        <span style="font-size:10px;">Your Account</span><br/>
                                                        <span style="font-size:20px; font-weight:bold;">
                                                            <t t-out="object.name or ''"/>
                                                        </span>
                                                    </td>
                                                    <td valign="middle" align="right" t-if="not object.company_id.uses_default_logo">
                                                        <img t-attf-src="/logo.png?company={{ object.company_id.id }}"
                                                             style="padding:0px; margin:0px; height:auto; width:80px;"
                                                             t-att-alt="object.company_id.name"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2" style="text-align:left;">
                                                        <hr width="100%"
                                                            style="background-color:rgb(204,204,204); border:medium none; clear:both; display:block; font-size:0px; min-height:1px; line-height:0; margin:16px 0px;"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <!-- CONTENT -->
                                    <tr>
                                        <td align="left" style="min-width:590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590"
                                                   style="min-width:590px; background-color:white; padding:0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="top" style="font-size:13px;">
                                                        <div>
                                                            Dear <t t-out="object.name or ''"/>,<br/><br/>
                                                            A sign-in link was requested for the account linked to this email.
                                                            Use the button below to sign in. This link can only be used once and will expire shortly.<br/>
                                                            <div style="margin:16px 0px;">
                                                                <a t-att-href="ctx.get('login_url')"
                                                                   t-attf-style="background-color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding:8px 16px; text-decoration:none; color: {{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius:5px; font-size:13px;">
                                                                    Sign in
                                                                </a>
                                                            </div>
                                                            If you did not request this sign-in link, you can safely ignore this email.<br/><br/>
                                                            Thanks,
                                                            <t t-if="user.signature">
                                                                <br/>
                                                                <t t-out="user.signature"/>
                                                            </t>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:left;">
                                                        <hr width="100%"
                                                            style="background-color:rgb(204,204,204); border:medium none; clear:both; display:block; font-size:0px; min-height:1px; line-height:0; margin:16px 0px;"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>

                                    <!-- FOOTER -->
                                    <tr>
                                        <td align="left" style="min-width:590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590"
                                                   style="min-width:590px; background-color:white; font-size:11px; padding:0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="middle" align="left">
                                                        <t t-out="object.company_id.name or ''"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td valign="middle" align="left" style="opacity:0.7;">
                                                        <t t-out="object.company_id.phone or ''"/>
                                                        <t t-if="object.company_id.email">
                                                            | <a t-att-href="'mailto:%s' % object.company_id.email"
                                                                 style="text-decoration:none; color:#454748;"
                                                                 t-out="object.company_id.email"/>
                                                        </t>
                                                        <t t-if="object.company_id.website">
                                                            | <a t-att-href="'%s' % object.company_id.website"
                                                                 style="text-decoration:none; color:#454748;"
                                                                 t-out="object.company_id.website"/>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
    </data>
</odoo>
